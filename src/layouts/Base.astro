---
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  alternateLinks,
  alternatePath,
  browsePath,
  feedbackPath,
  localizePath,
  resourceIndexPath,
  t,
  type Locale,
} from "../lib/i18n";
import { organizationLd, socialMeta, webSiteLd } from "../lib/seo";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { getCollection } from "astro:content";

/**
 * One page, one language.
 *
 * `lang` decides every chrome string (skip link, navigation, footer) and the
 * language the search engines are told about. When `multilingual` is on, the
 * page also advertises both editions with `hreflang` and carries the language
 * selector. Internal areas (the review hub, which stays bilingual on purpose)
 * switch it off, so no `hreflang` ever points at a page that does not exist.
 */
interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  /** Keep the page out of search engines (internal review areas). */
  noindex?: boolean;
  /** Advertise the other language and show the selector. */
  multilingual?: boolean;
  /** Where the selector goes, when it is not the same path in the other language. */
  alternateHref?: string;
  /** Extra JSON-LD nodes for this page. The layout already emits the site's own. */
  structuredData?: Record<string, unknown>[];
  /** Open Graph object type — "website" unless the page is a dated article. */
  ogType?: string;
}

const {
  title,
  lang = DEFAULT_LOCALE,
  description = t(lang, "homeDescription"),
  noindex = false,
  multilingual = true,
  alternateHref,
  structuredData = [],
  ogType = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = multilingual
  ? alternateLinks(Astro.url.pathname).map((link) => ({
      ...link,
      absolute: new URL(link.href, Astro.site).href,
    }))
  : [];
const switchHref = alternateHref ?? alternatePath(Astro.url.pathname);

/** Social-card values, and the JSON-LD graph this page publishes. */
const social = socialMeta({
  title,
  description,
  url: canonical.href,
  locale: lang,
  type: ogType,
});
/**
 * The site's own two nodes on every page, plus whatever the page adds. Kept as
 * one list so a page never has to remember to repeat the publisher.
 */
const structuredDataNodes = [organizationLd(), webSiteLd(lang), ...structuredData];

/**
 * How many resources are live, for the status strip. Addresses are counted once
 * (Traditional Chinese owns the root), so publishing a resource moves the number
 * by one in both languages rather than two.
 */
const liveResources = (
  await getCollection(
    "content",
    ({ data }) => data.lang === DEFAULT_LOCALE && !data.draft && data.type === "resource",
  )
).length;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.absolute} />
      ))
    }
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <!--
      Social cards. These also feed the link-preview surfaces that AI answer
      engines and chat clients render, so they are set on every page rather than
      only where someone remembered to add them.
    -->
    <meta property="og:site_name" content={social.siteName} />
    <meta property="og:type" content={social.type} />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    <meta property="og:url" content={social.url} />
    <meta property="og:image" content={social.image} />
    <meta property="og:image:width" content={String(social.imageWidth)} />
    <meta property="og:image:height" content={String(social.imageHeight)} />
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta property="og:locale" content={social.locale} />
    <meta property="og:locale:alternate" content={social.localeAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={social.image} />

    <!--
      Structured data: what the publisher is, what the site is, and (per page)
      what this page teaches. Search engines read it for rich results; AI answer
      engines read it to decide what may be quoted and how to attribute it.
      Emitted at build time, so a crawler that runs no JavaScript still sees it.
    -->
    {
      structuredDataNodes.map((node) => (
        <script type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    <!-- Brand typography: Quicksand (Latin) + Noto Sans TC (Chinese), as on beets3d.com -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />

    <!-- Brand mark + favicons: the Beets logo asset from beets3d.com -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, "skip")}</a>

    {
      liveResources > 0 ? (
        <div class="topbar">
          <div class="wrap">
            <span>
              {t(lang, "topbarPrefix")} <strong>{liveResources}</strong> {t(lang, "topbarSuffix")}
            </span>
            <a href={resourceIndexPath(lang)}>{t(lang, "navResources")} →</a>
          </div>
        </div>
      ) : null
    }

    <header class="site">
      <div class="wrap">
        <a class="brand" href={localizePath("/", lang)}>
          <img class="logo" src="/beets-logo.png" alt="" width="32" height="32" />
          <span class="mark">BEETS</span><span class="mark-alt">AI</span>
        </a>
        <div class="headright">
          <nav aria-label="BEETS AI">
            <a href={resourceIndexPath(lang)}>{t(lang, "navResources")}</a>
            <a href={browsePath(lang)}>{t(lang, "navBrowse")}</a>
            <a href={localizePath("/about/", lang)}>{t(lang, "navAbout")}</a>
          </nav>
          {
            multilingual ? (
              <LanguageSwitch current={lang} href={switchHref} />
            ) : null
          }
        </div>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>{t(lang, "footerDisclaimer")}</p>
        <p class="muted">
          © Beets Limited · <a href={localizePath("/about/", lang)}>{t(lang, "footerTerms")}</a> ·{" "}
          <a href={feedbackPath(lang)}>{t(lang, "footerFeedback")}</a> ·{" "}
          <a href="https://www.beets3d.com/">beets3d.com</a>
        </p>
      </div>
    </footer>

    <!--
      The site's design system, deliberately global: this block is the layout's
      contribution to every page, and Astro scopes component styles by default.
      Without `is:global`, the class rules here never reach markup rendered by the
      views (which pass through a slot with their own scope), so buttons, cards
      and callouts silently went unstyled while inherited properties such as the
      body font still applied — a confusing half-styled result.
    -->
    <style is:global>
      /*
        Brand tokens, taken from beets3d.com: brand red #E10707 as the primary
        accent, brand blue #116DFF secondary, light grey surfaces (#F3F3F3 and
        #E8E6E6), a soft 8% red wash for callouts, pill buttons and rounded
        cards. Quicksand for headings, generous line height, plenty of space.
      */
      :root {
        --accent: #e10707; /* brand red */
        --accent-ink: #b00505;
        --accent-tint: rgba(225, 7, 7, 0.08);
        --blue: #116dff; /* brand blue */
        --blue-ink: #0b53c9;
        --blue-tint: rgba(17, 109, 255, 0.08);
        --ink: #080808;
        --muted: #6f6f6f;
        --line: #e8e6e6;
        --surface: #f3f3f3;
        --surface-2: #e8e6e6;
        --bg: #ffffff;
        --radius: 18px;
        --radius-lg: 26px;
        --shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        --font: "Quicksand", "Noto Sans TC", system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.75;
        font-weight: 500;
      }
      .wrap {
        max-width: 54rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        background: var(--bg);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
      }

      /* ── Header ───────────────────────────────────────────────────────── */
      header.site {
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
        flex-wrap: wrap;
      }
      .headright {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: auto;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: 0.02em;
      }
      .brand .logo {
        display: block;
        width: 32px;
        height: 32px;
      }
      .brand .mark {
        color: var(--ink);
      }
      .brand .mark-alt {
        color: var(--accent);
        margin-left: 0.15em;
      }
      nav a {
        margin-left: 1.25rem;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      nav a:hover,
      nav a:focus-visible {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* ── Typography ───────────────────────────────────────────────────── */
      main {
        padding: 2.5rem 0 3rem;
      }
      h1 {
        font-size: clamp(2rem, 1.35rem + 2.6vw, 3.1rem);
        line-height: 1.2;
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0 0 0.75rem;
      }
      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 2.25rem 0 0.75rem;
      }
      h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 1.5rem 0 0.5rem;
      }
      /*
        The eyebrow label above a heading, as on beets3d.com: small, spaced out,
        and the first thing a section says.
      */
      .eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 0.35rem;
      }
      .eyebrow.blue {
        color: var(--blue);
      }
      .eyebrow.grey {
        color: var(--muted);
      }
      .lead {
        font-size: 1.05rem;
        color: #333;
        margin: 0 0 0.75rem;
      }
      a {
        color: var(--accent);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
      }
      a:hover {
        color: var(--accent-ink);
      }
      .muted,
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
      }
      hr {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 2rem 0;
      }
      code {
        background: var(--surface);
        border-radius: 6px;
        padding: 0.1em 0.35em;
        font-size: 0.9em;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin: 1rem 0;
        font-size: 0.95rem;
      }
      th,
      td {
        border: 1px solid var(--line);
        padding: 0.55rem 0.7rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: var(--surface);
        font-weight: 600;
      }
      blockquote {
        margin: 1.25rem 0;
        padding: 0.9rem 1.15rem;
        background: var(--surface);
        border-left: 4px solid var(--accent);
        border-radius: 0 var(--radius) var(--radius) 0;
      }
      blockquote p {
        margin: 0;
      }

      /* ── Cards ────────────────────────────────────────────────────────── */
      .cards {
        list-style: none;
        padding: 0;
        margin: 1.25rem 0;
        display: grid;
        gap: 0.9rem;
      }
      .cards li {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        background: var(--bg);
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .cards li:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow);
        transform: translateY(-2px);
      }
      .cards a {
        font-weight: 600;
        text-decoration: none;
        font-size: 1.05rem;
      }
      .cards a:hover {
        text-decoration: underline;
      }
      .cards .meta {
        margin-top: 0.15rem;
      }

      /* ── Buttons, bands and callouts ───────────────────────────────────── */
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #fff !important;
        text-decoration: none;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 999px;
      }
      .btn:hover {
        background: var(--accent-ink);
        box-shadow: var(--shadow);
      }
      .btn.ghost {
        background: #fff;
        color: var(--ink) !important;
        border: 1px solid var(--line);
      }
      .btn.ghost:hover {
        background: var(--surface);
        border-color: var(--ink);
      }
      .btn.blue {
        background: var(--blue);
      }
      .btn.blue:hover {
        background: var(--blue-ink);
      }
      .btn-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
        margin: 1.25rem 0;
      }
      .panel {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 1.35rem 1.5rem;
        margin: 1.5rem 0;
      }
      .band {
        background: var(--accent-tint);
        border-radius: var(--radius-lg);
        padding: 1.6rem 1.75rem;
        margin: 2.25rem 0;
      }
      .band.grey {
        background: var(--surface);
      }
      .band h2 {
        margin-top: 0;
      }
      .band > :last-child {
        margin-bottom: 0;
      }
      .notice {
        background: var(--accent-tint);
        border-radius: var(--radius);
        padding: 0.95rem 1.15rem;
        margin: 1.25rem 0;
        font-size: 0.95rem;
      }
      /* Status strip above the header, mirroring the bar on beets3d.com. */
      .topbar {
        background: var(--accent-tint);
        font-size: 0.85rem;
        padding: 0.45rem 0;
      }
      .topbar .wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 0.5rem;
        align-items: baseline;
      }
      .topbar a {
        font-weight: 600;
        text-decoration: none;
      }

      /* ── Footer ───────────────────────────────────────────────────────── */
      footer.site {
        background: var(--surface);
        border-top: 1px solid var(--line);
        padding: 2rem 0;
        font-size: 0.9rem;
      }
      footer.site p {
        margin: 0.35rem 0;
      }
      footer.site .muted {
        color: var(--muted);
      }
    </style>
  </body>
</html>
