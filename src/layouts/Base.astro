---
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  alternateLinks,
  alternatePath,
  browsePath,
  feedbackPath,
  localizePath,
  resourceIndexPath,
  t,
  type Locale,
} from "../lib/i18n";
import LanguageSwitch from "../components/LanguageSwitch.astro";

/**
 * One page, one language.
 *
 * `lang` decides every chrome string (skip link, navigation, footer) and the
 * language the search engines are told about. When `multilingual` is on, the
 * page also advertises both editions with `hreflang` and carries the language
 * selector. Internal areas (the review hub, which stays bilingual on purpose)
 * switch it off, so no `hreflang` ever points at a page that does not exist.
 */
interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  /** Keep the page out of search engines (internal review areas). */
  noindex?: boolean;
  /** Advertise the other language and show the selector. */
  multilingual?: boolean;
  /** Where the selector goes, when it is not the same path in the other language. */
  alternateHref?: string;
}

const {
  title,
  lang = DEFAULT_LOCALE,
  description = t(lang, "homeDescription"),
  noindex = false,
  multilingual = true,
  alternateHref,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = multilingual
  ? alternateLinks(Astro.url.pathname).map((link) => ({
      ...link,
      absolute: new URL(link.href, Astro.site).href,
    }))
  : [];
const switchHref = alternateHref ?? alternatePath(Astro.url.pathname);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.absolute} />
      ))
    }
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <!-- Brand typography: Quicksand (Latin) + Noto Sans TC (Chinese), as on beets3d.com -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />

    <!-- Brand mark + favicons: the Beets logo asset from beets3d.com -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, "skip")}</a>

    <header class="site">
      <div class="wrap">
        <a class="brand" href={localizePath("/", lang)}>
          <img class="logo" src="/beets-logo.png" alt="" width="32" height="32" />
          <span class="mark">BEETS</span><span class="mark-alt">AI</span>
        </a>
        <div class="headright">
          <nav aria-label="BEETS AI">
            <a href={resourceIndexPath(lang)}>{t(lang, "navResources")}</a>
            <a href={browsePath(lang)}>{t(lang, "navBrowse")}</a>
            <a href={localizePath("/about/", lang)}>{t(lang, "navAbout")}</a>
          </nav>
          {
            multilingual ? (
              <LanguageSwitch current={lang} href={switchHref} />
            ) : null
          }
        </div>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>{t(lang, "footerDisclaimer")}</p>
        <p class="muted">
          © Beets Limited · <a href={localizePath("/about/", lang)}>{t(lang, "footerTerms")}</a> ·{" "}
          <a href={feedbackPath(lang)}>{t(lang, "footerFeedback")}</a> ·{" "}
          <a href="https://www.beets3d.com/">beets3d.com</a>
        </p>
      </div>
    </footer>

    <style>
      /* ── Brand tokens, taken from beets3d.com ─────────────────────────── */
      :root {
        --accent: #e10707; /* brand red */
        --accent-ink: #b00505;
        --accent-soft: #fdead2;
        --cream: #fef6ed;
        --cream-2: #fdf1ec;
        --ink: #000000;
        --muted: #8f8f8f;
        --line: #e2e2e2;
        --surface: #f2f2f2;
        --bg: #ffffff;
        --radius: 14px;
        --font: "Quicksand", "Noto Sans TC", system-ui, -apple-system, sans-serif;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.75;
        font-weight: 500;
      }
      .wrap {
        max-width: 54rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        background: var(--bg);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
      }

      /* ── Header ───────────────────────────────────────────────────────── */
      header.site {
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
        flex-wrap: wrap;
      }
      .headright {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: auto;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: 0.02em;
      }
      .brand .logo {
        display: block;
        width: 32px;
        height: 32px;
      }
      .brand .mark {
        color: var(--ink);
      }
      .brand .mark-alt {
        color: var(--accent);
        margin-left: 0.15em;
      }
      nav a {
        margin-left: 1.25rem;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      nav a:hover,
      nav a:focus-visible {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* ── Typography ───────────────────────────────────────────────────── */
      main {
        padding: 2.5rem 0 3rem;
      }
      h1 {
        font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
        line-height: 1.25;
        font-weight: 700;
        margin: 0 0 0.5rem;
      }
      h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 2.25rem 0 0.75rem;
      }
      h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 1.5rem 0 0.5rem;
      }
      a {
        color: var(--accent);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
      }
      a:hover {
        color: var(--accent-ink);
      }
      .muted,
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
      }
      hr {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 2rem 0;
      }
      code {
        background: var(--surface);
        border-radius: 6px;
        padding: 0.1em 0.35em;
        font-size: 0.9em;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin: 1rem 0;
        font-size: 0.95rem;
      }
      th,
      td {
        border: 1px solid var(--line);
        padding: 0.55rem 0.7rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: var(--cream);
        font-weight: 700;
      }
      blockquote {
        margin: 1.25rem 0;
        padding: 0.85rem 1.1rem;
        background: var(--cream);
        border-left: 4px solid var(--accent);
        border-radius: 0 var(--radius) var(--radius) 0;
      }
      blockquote p {
        margin: 0;
      }

      /* ── Cards ────────────────────────────────────────────────────────── */
      .cards {
        list-style: none;
        padding: 0;
        margin: 1.25rem 0;
        display: grid;
        gap: 0.85rem;
      }
      .cards li {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1rem 1.15rem;
        background: var(--bg);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .cards li:hover {
        border-color: var(--accent);
        box-shadow: 0 2px 12px rgba(225, 7, 7, 0.08);
      }
      .cards a {
        font-weight: 700;
        text-decoration: none;
        font-size: 1.05rem;
      }
      .cards a:hover {
        text-decoration: underline;
      }
      .cards .meta {
        margin-top: 0.15rem;
      }

      /* ── Buttons & callouts ───────────────────────────────────────────── */
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #fff !important;
        text-decoration: none;
        font-weight: 700;
        padding: 0.7rem 1.25rem;
        border-radius: 999px;
      }
      .btn:hover {
        background: var(--accent-ink);
      }
      .panel {
        background: var(--cream);
        border-radius: var(--radius);
        padding: 1.25rem 1.4rem;
        margin: 1.5rem 0;
      }
      .notice {
        background: var(--accent-soft);
        border-radius: var(--radius);
        padding: 0.9rem 1.1rem;
        margin: 1.25rem 0;
        font-size: 0.95rem;
      }

      /* ── Footer ───────────────────────────────────────────────────────── */
      footer.site {
        background: var(--cream-2);
        border-top: 1px solid var(--line);
        padding: 2rem 0;
        font-size: 0.9rem;
      }
      footer.site p {
        margin: 0.35rem 0;
      }
      footer.site .muted {
        color: #7a6a60;
      }
    </style>
  </body>
</html>
