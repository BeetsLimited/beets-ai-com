---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

/**
 * Internal review hub.
 *
 * Deliberately bilingual and excluded from search engines: it is the one page
 * the team reads in both languages at once. `multilingual={false}` keeps the
 * language switch and the `hreflang` alternates off it — those links would 404
 * here, since the review area is not published per language under /en/.
 */
const drafts = (await getCollection("content", ({ data }) => data.draft)).sort((a, b) =>
  a.data.address.localeCompare(b.data.address),
);

const addresses = [...new Set(drafts.map((entry) => entry.data.address))];

/** Per-resource review checklist, keyed by the resource address. */
const CHECKS: Record<string, { fact: string[]; educator: string[] }> = {
  "safe-to-upload-ai-rehearsal": {
    fact: [
      "六份示例全部為虛構，沒有影射任何真實學生或學校個案",
      "所列的移除手法與 EDB 文件 G（pp.2-4, 2-9）的說法一致",
      "「檔案名稱 / 中繼資料」的風險描述正確",
    ],
    educator: [
      "「讀寫障礙」示例是否適合香港學校的文化與敏感度",
      "45 分鐘的課堂時間是否可行",
      "六份示例的難度是否適合 P4–P6",
    ],
  },
  "student-ai-use-process-sheet": {
    fact: [
      "五格架構忠實反映 F（p.1-13）重視歷程、G（p.2-8）以思考歷程檢視學習的要求",
      "「不必交出完整對話紀錄」符合私隱與資料最小化的做法",
    ],
    educator: [
      "第 4 格是否真的能用一句話寫完",
      "是否符合實際課業時間",
      "表內不綁定學科的設計是否合用",
    ],
  },
  "p4-hk-population-ai-graph-check": {
    fact: [
      "⚠️ 最重要：2021 年人口 7,413,070 須與政府統計處 2021 年人口普查一致",
      "⚠️ 「人口並非逐年上升」在現行官方數據下仍然成立",
      "⚠️ 要求學生填寫的年份與 Table 110-01001 現行版本一致",
      "⚠️ censtatd.gov.hk 的來源連結仍然有效",
      "⚠️ 英文版的數字、來源與中文版完全一致（英文版為新譯本）",
    ],
    educator: [
      "35–40 分鐘對 P4 是否合適",
      "「AI 對了一半」這個切入點是否 P4 學生能掌握",
      "方格紙／試算表的器材假設是否合理",
      "英文版的用語是否適合香港小學教師",
    ],
  },
};

const editionsOf = (address: string) =>
  drafts.filter((entry) => entry.data.address === address);

const reviewHref = (address: string, lang: string) =>
  lang === "en" ? `/review/en/${address}/` : `/review/${address}/`;
---

<Base title="內部審閱 Internal review — BEETS AI" noindex multilingual={false}>
  <h1>內部審閱 Internal review</h1>

  <div class="notice">
    <strong>此區域不對外發佈，亦不會被搜尋引擎收錄。</strong>
    <p>
      以下 {addresses.length} 份資源已完成草擬，每份均有<strong>繁體中文版</strong>及<strong>英文版</strong>，
      兩者正在等待事實核實及教育工作者審閱。在兩項完成前，兩個版本都不會在任何正式網址發佈。
    </p>
    <p class="muted">
      Not public, excluded from search engines. These {addresses.length} resources each have a
      Traditional Chinese and an English edition, both awaiting fact-check and educator review
      before publication.
    </p>
  </div>

  {
    addresses.map((address) => {
      const editions = editionsOf(address);
      const zh = editions.find((entry) => entry.data.lang === "zh-HK");
      const en = editions.find((entry) => entry.data.lang === "en");
      const lead = zh ?? en;
      const checks = CHECKS[address];
      return (
        <section>
          <h2>{lead?.data.title}</h2>
          <p class="meta">
            Theme {lead?.data.theme} · {lead?.data.stage} · {lead?.data.subject} · 來源{" "}
            {lead?.data.sources.join("、")}
          </p>

          <ul>
            {zh ? (
              <li>
                <a href={reviewHref(address, "zh-HK")}>繁體中文版 Traditional Chinese →</a>
              </li>
            ) : null}
            {en ? (
              <li>
                <a href={reviewHref(address, "en")}>English edition 英文版 →</a>
              </li>
            ) : null}
          </ul>

          {checks ? (
            <>
              <h3>① 事實核實 Fact-check</h3>
              <ul>
                {checks.fact.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <h3>② 教育工作者審閱 Educator review（Henry）</h3>
              <ul>
                {checks.educator.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          ) : null}
        </section>
      );
    })
  }

  <hr />
  <h2>如何回應 How to respond</h2>
  <p>
    在 Mattermost 告訴 Ada「#8 可發佈」、「#11 英文版需修改：……」，並註明事實核實者姓名。
    兩項關卡通過後，中英文版會同時設為正式發佈，並提交 Google Search Console 與 Bing IndexNow。
  </p>
  <p class="muted">
    Reply in Mattermost with your sign-off (and who did the fact-checking). Once both gates pass,
    the Chinese and English editions are published together at their public URLs.
  </p>
</Base>
