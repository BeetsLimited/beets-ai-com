---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ResourceView from "../../components/ResourceView.astro";

export async function getStaticPaths() {
  const drafts = await getCollection("content", ({ data }) => data.draft);
  return drafts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
---

<Base title={`[草稿] ${d.title} — BEETS AI`} description={d.description} lang={d.lang} noindex>
  <p class="meta">
    <a href="/review/">← 返回內部審閱 Back to internal review</a>
  </p>

  <ResourceView entry={entry} reviewMode />

  <p class="meta">
    正式網址將為 <code>/resources/{d.slug}/</code>（通過兩項關卡後才會生效）。
  </p>
</Base>
