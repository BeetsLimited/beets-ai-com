---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import ResourceView from "../../../components/ResourceView.astro";
import { SECONDARY_LOCALE } from "../../../lib/i18n";
import { alternateHrefFor } from "../../../lib/resources";

const lang = SECONDARY_LOCALE;

export async function getStaticPaths() {
  const all = await getCollection("content");
  return all
    .filter((entry) => !entry.data.draft && entry.data.lang === SECONDARY_LOCALE)
    .map((entry) => ({
      params: { slug: entry.data.address },
      props: { entry, alternateHref: alternateHrefFor(entry, all) },
    }));
}

const { entry, alternateHref } = Astro.props;
---

<Base
  title={`${entry.data.title} — BEETS AI`}
  description={entry.data.description}
  lang={lang}
  alternateHref={alternateHref}
>
  <ResourceView entry={entry} lang={lang} />
</Base>
