---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const published = (await getCollection("content", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="BEETS AI — 香港教師 AI 課堂實用資源">
  <h1>香港教師 AI 課堂實用資源</h1>
  <p>
    按學科、級別和具體教學需要，免費取得可編輯工作紙、教案及校本規劃範例。
  </p>
  <p class="meta">
    Free, educator-reviewed Hong Kong AI teaching resources — by subject, stage
    and specific classroom task.
  </p>

  {
    published.length === 0 ? (
      <p>資源陸續上線，請稍後再來。Resources are being published — check back soon.</p>
    ) : (
      <ul>
        {published.map((entry) => (
          <li>
            <a href={`/resources/${entry.data.slug}/`}>{entry.data.title}</a>
            <div class="meta">
              {entry.data.stage} · {entry.data.subject}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</Base>
