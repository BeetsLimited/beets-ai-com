---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ResourceView from "../../components/ResourceView.astro";

// Published resources only — anything with `draft: true` is served (unindexed)
// under /review/ instead, until it passes the fact-check and educator gates.
export async function getStaticPaths() {
  const entries = await getCollection("content", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
---

<Base title={`${d.title} — BEETS AI`} description={d.description} lang={d.lang}>
  <ResourceView entry={entry} />
</Base>
