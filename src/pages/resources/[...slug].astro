---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ResourceView from "../../components/ResourceView.astro";
import { DEFAULT_LOCALE, localizePath, resourceIndexPath, t } from "../../lib/i18n";
import { alternateHrefFor, relatedTo } from "../../lib/resources";
import { breadcrumbLd, learningResourceLd } from "../../lib/seo";

const lang = DEFAULT_LOCALE;

// Published resources only — anything with `draft: true` is served (unindexed)
// under /review/ instead, until it passes the fact-check and educator gates.
export async function getStaticPaths() {
  const all = await getCollection("content");
  return all
    .filter((entry) => !entry.data.draft && entry.data.lang === DEFAULT_LOCALE)
    .map((entry) => ({
      params: { slug: entry.data.address },
      props: {
        entry,
        alternateHref: alternateHrefFor(entry, all),
        related: relatedTo(entry, all).map((other) => ({
          address: other.data.address,
          title: other.data.title,
        })),
      },
    }));
}

const { entry, alternateHref, related } = Astro.props;

/** Absolute URLs for the structured-data graph (relative ones are not valid there). */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(localizePath("/", lang), Astro.site).href;
const resourcesUrl = new URL(resourceIndexPath(lang), Astro.site).href;
---

<Base
  title={`${entry.data.title} — BEETS AI`}
  description={entry.data.description}
  lang={lang}
  alternateHref={alternateHref}
  ogType="article"
  ogImage={entry.data.image}
  ogImageAlt={entry.data.imageAlt}
  structuredData={[
    learningResourceLd(entry, lang, canonicalUrl),
    breadcrumbLd([
      { name: t(lang, "breadcrumbHome"), url: homeUrl },
      { name: t(lang, "navResources"), url: resourcesUrl },
      { name: entry.data.title, url: canonicalUrl },
    ]),
  ]}
>
  <ResourceView entry={entry} lang={lang} related={related} />
</Base>
