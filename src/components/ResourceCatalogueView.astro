---
import { getCollection } from "astro:content";
import { isPublished } from "../lib/review-gate";
import { resourcesPath, t, themeLabel, type Locale } from "../lib/i18n";
import { assertPairedEditions, newestFirst } from "../lib/resources";
import {
  FACETS,
  PAGE_SIZE,
  filterItems,
  filterOptions,
  haystackFor,
  paginate,
  type CatalogueFacet,
  type CatalogueFilters,
  type CatalogueLocked,
} from "../lib/catalogue";

/**
 * The resource catalogue — ONE template for every listing/search page.
 *
 * A page composes it and passes what it wants to fix or pre-select:
 *
 *   <ResourceCatalogueView lang={lang} />                          ← /resources/
 *   <ResourceCatalogueView lang={lang} locked={{ theme: "A" }}     ← /by-theme/school-planning/
 *                          heading={themeLabel(lang, "A")} />
 *
 * `locked` criteria are held fixed and shown as a chip, not as tags the reader
 * can contradict. `initial` criteria are pre-selected but the reader can change
 * them. So a theme page and the full index share one UI while only differing in
 * what they start with.
 *
 * Criteria are chosen as TAGS, and a group can hold several: tags inside a group
 * are OR-ed (科學 + 數學 → either), groups are AND-ed with each other. The UI says
 * so rather than leaving the reader to guess.
 *
 * **Every card is in the HTML.** The filtering and paging below are applied by a
 * small script that HIDES cards it was already given — never by fetching them.
 * A crawler with no JavaScript, and a reader with a broken script, still see the
 * whole catalogue with working links. `scripts/check-catalogue.mjs` fails the
 * build if that ever stops being true.
 */
interface Props {
  lang: Locale;
  /** Defaults to the resource-index copy. */
  heading?: string;
  lede?: string;
  /** Criteria this page fixes. Rendered as a chip, never as tags. */
  locked?: CatalogueLocked;
  /** Criteria pre-selected but still changeable. */
  initial?: CatalogueFilters;
  pageSize?: number;
}

const {
  lang,
  heading = t(lang, "resourcesTitle"),
  lede = t(lang, "resourcesLede"),
  locked = {},
  initial = {},
  pageSize = PAGE_SIZE,
} = Astro.props;

const all = await getCollection("content");
// Build-time guard: an edition the loader silently dropped must break the build.
assertPairedEditions(all, "catalogue");

const published = newestFirst(
  all.filter(({ data }) => isPublished(data) && data.type === "resource" && data.lang === lang),
);

const items = published.map((entry) => ({
  address: entry.data.address,
  title: entry.data.title,
  image: entry.data.image,
  imageAlt: entry.data.imageAlt,
  theme: entry.data.theme,
  stage: entry.data.stage,
  subject: entry.data.subject,
  /** What the keyword box searches. Built by the same helper the tests drive. */
  haystack: haystackFor([entry.data.title, entry.data.description]),
}));

const options = filterOptions(items);
/** What this page starts with: its locked criteria, then its pre-selections. */
const defaults: CatalogueFilters = { ...initial };
for (const facet of FACETS) {
  if (locked[facet]) defaults[facet] = [locked[facet] as string];
}
const firstPage = paginate(filterItems(items, defaults), 1, pageSize);

const countText = (from: number, to: number, total: number) =>
  t(lang, "catalogueCountTemplate")
    .replace("{from}", String(from))
    .replace("{to}", String(to))
    .replace("{total}", String(total));

/**
 * One tag group per facet, and only when it can change the result: a locked facet
 * is shown as a chip instead, and a facet with a single value offers nothing to
 * choose between.
 */
const tagGroups = [
  {
    facet: "theme" as CatalogueFacet,
    label: t(lang, "catalogueFilterTheme"),
    values: options.themes,
    localise: (value: string) => themeLabel(lang, value),
  },
  {
    facet: "stage" as CatalogueFacet,
    label: t(lang, "catalogueFilterStage"),
    values: options.stages,
    localise: (value: string) => value,
  },
  {
    facet: "subject" as CatalogueFacet,
    label: t(lang, "catalogueFilterSubject"),
    values: options.subjects,
    localise: (value: string) => value,
  },
].filter((group) => !locked[group.facet] && group.values.length > 1);

const lockedChips = [
  { facet: "theme" as CatalogueFacet, label: t(lang, "catalogueFilterTheme"), value: locked.theme },
  { facet: "stage" as CatalogueFacet, label: t(lang, "catalogueFilterStage"), value: locked.stage },
  {
    facet: "subject" as CatalogueFacet,
    label: t(lang, "catalogueFilterSubject"),
    value: locked.subject,
  },
]
  .filter((chip) => Boolean(chip.value))
  .map((chip) => ({
    ...chip,
    display: chip.facet === "theme" ? themeLabel(lang, chip.value as string) : (chip.value as string),
  }));
---

<section
  class="catalogue"
  data-catalogue
  data-page-size={String(pageSize)}
  data-locked={JSON.stringify(locked)}
  data-defaults={JSON.stringify(defaults)}
  data-count-template={t(lang, "catalogueCountTemplate")}
  data-label-prev={t(lang, "cataloguePrevAria")}
  data-label-next={t(lang, "catalogueNextAria")}
  data-label-pager={t(lang, "cataloguePagerAria")}
>
  <h1>{heading}</h1>
  <p class="lede">{lede}</p>

  <form class="filters" data-filters>
    <h2 class="filters-title">{t(lang, "catalogueSearchHeading")}</h2>
    <p class="filters-hint">{t(lang, "catalogueMultiHint")}</p>

    {
      lockedChips.length > 0 ? (
        <ul class="chips">
          {lockedChips.map((chip) => (
            <li class="chip">
              {chip.label}：<strong>{chip.display}</strong>
              <span class="muted"> · {t(lang, "catalogueLockedNote")}</span>
            </li>
          ))}
        </ul>
      ) : null
    }

    {
      tagGroups.map((group) => (
        <div class="tag-group" role="group" aria-label={group.label}>
          <p class="tag-label">{group.label}</p>
          <ul class="tags">
            {group.values.map((value) => {
              const pressed = (defaults[group.facet] ?? []).includes(value);
              return (
                <li>
                  <button
                    type="button"
                    class="tag"
                    data-tag
                    data-facet={group.facet}
                    data-value={value}
                    aria-pressed={pressed ? "true" : "false"}
                  >
                    {group.localise(value)}
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <div class="filter-row">
      <label class="filter-field filter-search">
        {t(lang, "catalogueFilterKeyword")}
        <input
          type="search"
          data-filter="q"
          value={defaults.q ?? ""}
          placeholder={t(lang, "catalogueFilterKeywordPlaceholder")}
        />
      </label>
      <div class="filter-actions">
        <button type="reset" class="btn card-cta">{t(lang, "catalogueResetFilters")}</button>
      </div>
    </div>
  </form>

  <p class="catalogue-count" data-count aria-live="polite">
    {countText(firstPage.from, firstPage.to, firstPage.total)}
  </p>

  <ul class="card-grid catalogue-grid" data-grid>
    {
      items.map((item) => (
        <li
          class="card resource-card"
          data-card
          data-theme={item.theme}
          data-stage={item.stage}
          data-subject={item.subject}
          data-haystack={item.haystack}
        >
          {item.image ? (
            <img
              class="card-art"
              src={item.image}
              alt={item.imageAlt ?? item.title}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          ) : null}
          <h3>{item.title}</h3>
          <p class="meta">
            {item.stage} · {item.subject} · {themeLabel(lang, item.theme)}
          </p>
          <div class="card-cta-row">
            <a class="btn card-cta" href={resourcesPath(lang, item.address)}>
              {t(lang, "cardCtaResource")}
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="panel" data-empty hidden>
    <p>{t(lang, "catalogueEmpty")}</p>
  </div>

  <nav class="pager" data-pager aria-label={t(lang, "cataloguePagerAria")} hidden></nav>

  <noscript>
    <div class="notice">
      <p>{t(lang, "catalogueNoScript")}</p>
    </div>
  </noscript>
</section>

<style>
  /* Catalogue-only chrome. The cards themselves are the site-wide `.card`,
     `.card-grid` and `.card-cta` from the layout, so this page and the homepage
     cannot drift apart. */
  .filters {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem 1.15rem;
    margin: 1.5rem 0 1.25rem;
  }
  .filters-title {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  .filters-hint {
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tag-group {
    margin: 0 0 0.9rem;
  }
  .tag-label {
    margin: 0 0 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  /* A tag is the standard button as a toggle: white fill and corporate text when
     unselected, corporate fill and white text when selected. */
  .tag {
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--corporate);
    background: #fff;
    border: 1px solid var(--corporate);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .tag:hover {
    background: var(--corporate-tint);
  }
  .tag[aria-pressed="true"] {
    background: var(--corporate);
    color: #fff;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.9rem 1.1rem;
    margin-top: 0.35rem;
  }
  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .filter-field input {
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.5rem 0.7rem;
    min-width: 15rem;
  }
  .filter-field input:focus-visible {
    outline: 2px solid var(--corporate);
    outline-offset: 1px;
  }
  .filter-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .chips {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
  }

  /* ── Five across: ten resources are two rows, and paging shows the next ten ──
     The column count is ENCODED, not left to auto-fit: in this container
     auto-fit silently yields four columns, which is a different page. */
  .catalogue-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  /* A 160px card needs its own rhythm: the site-wide card padding and type sizes
     are set for three across. */
  .catalogue-grid .card {
    padding: 0.9rem 0.95rem;
  }
  .catalogue-grid .card-art {
    margin-bottom: 0.6rem;
    border-radius: 12px;
  }
  .catalogue-grid .card h3 {
    margin: 0.25rem 0 0.3rem;
    font-size: 0.95rem;
  }
  .catalogue-grid .card .meta {
    font-size: 0.8rem;
  }
  .catalogue-grid .card-cta-row {
    margin-top: 0.65rem;
  }
  .catalogue-grid .card-cta {
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
  }
  @media (max-width: 60rem) {
    .catalogue-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 48rem) {
    .catalogue-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .catalogue-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 26rem) {
    .catalogue-grid {
      grid-template-columns: 1fr;
    }
  }

  .catalogue-count {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
  }
  /* Numbered pager: digits and arrows only, so it needs no localised strings
     beyond the aria-labels, which come from the page. */
  .pager button {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    min-width: 2.5rem;
    padding: 0.45rem 0.7rem;
    color: var(--corporate);
    background: #fff;
    border: 1px solid var(--corporate);
    border-radius: 999px;
    cursor: pointer;
  }
  .pager button:hover:not([disabled]),
  .pager button:active:not([disabled]) {
    background: var(--corporate);
    color: #fff;
  }
  .pager button[aria-current="page"] {
    background: var(--corporate);
    color: #fff;
  }
  .pager button[disabled] {
    color: var(--muted);
    border-color: var(--line);
    cursor: default;
  }
</style>

<script>
  /**
   * The catalogue's behaviour: toggle tags, filter, page, and keep the URL in
   * step.
   *
   * It imports the very rules `tests/catalogue.test.ts` drives, so the browser
   * cannot disagree with the tests about what matches or what page 2 holds. The
   * cards are already in the DOM — this only decides which of them are shown.
   */
  import {
    clampPage,
    matches,
    paginate,
    readState,
    toggleValue,
    withLocked,
    writeState,
    type CatalogueFacet,
    type CatalogueFilters,
    type CatalogueItem,
    type CatalogueLocked,
  } from "../lib/catalogue";

  const KEYWORD_DELAY = 150;

  function initCatalogue(root: HTMLElement) {
    const pairs = Array.from(root.querySelectorAll<HTMLElement>("[data-card]")).map((card) => ({
      card,
      item: {
        theme: card.dataset.theme ?? "",
        stage: card.dataset.stage ?? "",
        subject: card.dataset.subject ?? "",
        haystack: card.dataset.haystack ?? "",
      } satisfies CatalogueItem,
    }));

    const tags = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tag]"));
    const keyword = root.querySelector<HTMLInputElement>('input[data-filter="q"]');
    const countEl = root.querySelector<HTMLElement>("[data-count]");
    const emptyEl = root.querySelector<HTMLElement>("[data-empty]");
    const pagerEl = root.querySelector<HTMLElement>("[data-pager]");
    const form = root.querySelector<HTMLFormElement>("form[data-filters]");

    const pageSize = Math.max(1, Number(root.dataset.pageSize) || 10);
    const template = root.dataset.countTemplate ?? "";
    const locked = JSON.parse(root.dataset.locked ?? "{}") as CatalogueLocked;

    let state: { filters: CatalogueFilters; page: number } = { filters: {}, page: 1 };

    /** What the tags and the keyword box currently say. */
    const readControls = (): CatalogueFilters => {
      const filters: CatalogueFilters = {};
      for (const tag of tags) {
        const facet = tag.dataset.facet as CatalogueFacet | undefined;
        const value = tag.dataset.value ?? "";
        if (!facet || !value || tag.getAttribute("aria-pressed") !== "true") continue;
        filters[facet] = [...(filters[facet] ?? []), value];
      }
      const query = keyword?.value.trim();
      if (query) filters.q = query;
      // A locked facet is never read from the tags: the page owns it.
      return withLocked(filters, locked);
    };

    /** Paint the controls from the state. */
    const writeControls = () => {
      for (const tag of tags) {
        const facet = tag.dataset.facet as CatalogueFacet | undefined;
        if (!facet) continue;
        const selected = (state.filters[facet] ?? []).includes(tag.dataset.value ?? "");
        tag.setAttribute("aria-pressed", selected ? "true" : "false");
      }
      if (keyword) keyword.value = state.filters.q ?? "";
    };

    const render = (page: ReturnType<typeof paginate<(typeof pairs)[number]>>) => {
      if (countEl) {
        countEl.textContent = template
          .replace("{from}", String(page.from))
          .replace("{to}", String(page.to))
          .replace("{total}", String(page.total));
      }
      if (emptyEl) emptyEl.hidden = page.total > 0;
      if (!pagerEl) return;

      pagerEl.replaceChildren();
      if (page.pages <= 1) {
        pagerEl.hidden = true;
        return;
      }
      pagerEl.hidden = false;

      const step = (glyph: string, target: number, aria: string | undefined, disabled: boolean) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = glyph;
        if (aria) button.setAttribute("aria-label", aria);
        button.disabled = disabled;
        if (!disabled) {
          button.addEventListener("click", () => {
            state.page = target;
            apply();
          });
        }
        return button;
      };

      pagerEl.append(step("←", page.page - 1, root.dataset.labelPrev, page.page === 1));
      for (let number = 1; number <= page.pages; number += 1) {
        const button = step(String(number), number, undefined, false);
        if (number === page.page) {
          button.setAttribute("aria-current", "page");
          button.disabled = true;
        }
        pagerEl.append(button);
      }
      pagerEl.append(step("→", page.page + 1, root.dataset.labelNext, page.page === page.pages));
    };

    const apply = () => {
      const shown = pairs.filter(({ item }) => matches(item, state.filters));
      state.page = clampPage(state.page, shown.length, pageSize);
      const page = paginate(shown, state.page, pageSize);

      for (const { card } of pairs) card.hidden = true;
      for (const { card } of page.items) card.hidden = false;

      render(page);

      // The filtered view is linkable: a teacher can paste it into the staff room.
      const query = writeState({ filters: state.filters, page: state.page });
      window.history.replaceState(null, "", query ? `?${query}` : window.location.pathname);
    };

    const update = () => {
      state = { filters: readControls(), page: 1 };
      apply();
    };

    /**
     * Clicking a tag toggles it. `aria-pressed` on a <button> is NOT flipped by
     * the browser — nothing happens unless we flip it — so the click is turned
     * into state first and the tags are painted back from that state. The toggle
     * itself is `toggleValue`, the same function the tests drive.
     */
    const toggleTag = (tag: HTMLButtonElement) => {
      const facet = tag.dataset.facet as CatalogueFacet | undefined;
      const value = tag.dataset.value ?? "";
      if (!facet || !value) return;
      const filters = readControls();
      filters[facet] = toggleValue(filters[facet], value);
      state = { filters: withLocked(filters, locked), page: 1 };
      writeControls();
      apply();
    };

    for (const tag of tags) tag.addEventListener("click", () => toggleTag(tag));

    let keywordTimer: number | undefined;
    keyword?.addEventListener("input", () => {
      window.clearTimeout(keywordTimer);
      keywordTimer = window.setTimeout(update, KEYWORD_DELAY);
    });

    form?.addEventListener("submit", (event) => event.preventDefault());
    /**
     * A native reset clears the keyword box, but the tags are buttons and know
     * nothing about it — so unpress them here, after the browser has finished.
     */
    form?.addEventListener("reset", () =>
      window.setTimeout(() => {
        for (const tag of tags) tag.setAttribute("aria-pressed", "false");
        update();
      }, 0),
    );

    // Arriving with a link: the query string beats this page's *defaults*, but
    // never this page's locked criteria.
    const fromUrl = readState(window.location.search, readControls());
    state = { filters: withLocked(fromUrl.filters, locked), page: fromUrl.page };
    writeControls();
    apply();
  }

  for (const root of Array.from(document.querySelectorAll<HTMLElement>("[data-catalogue]"))) {
    initCatalogue(root);
  }
</script>
