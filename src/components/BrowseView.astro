---
import { getCollection } from "astro:content";
import { isPublished } from "../lib/review-gate";
import GroupedResourceList from "./GroupedResourceList.astro";
import { resourceIndexPath, t, type Locale } from "../lib/i18n";
import { groupByLabel, newestFirst } from "../lib/resources";

/**
 * Browse by subject and stage.
 *
 * Filters are labels on the same resources — not separate near-identical pages —
 * and only labels that actually have material are shown.
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const published = newestFirst(
  await getCollection(
    "content",
    ({ data }) => isPublished(data) && data.type === "resource" && data.lang === lang,
  ),
);

const byStage = groupByLabel(published, (entry) => entry.data.stage);
const bySubject = groupByLabel(published, (entry) => entry.data.subject);
---

<h1>{t(lang, "browseTitle")}</h1>
<p>{t(lang, "browseLede")}</p>

{
  published.length === 0 ? (
    <div class="panel">
      <p>{t(lang, "browseEmpty")}</p>
      <p>
        <a class="btn" href={resourceIndexPath(lang)}>
          {t(lang, "browseSeeAll")} →
        </a>
      </p>
    </div>
  ) : (
    <>
      <h2>{t(lang, "browseStagesHeading")}</h2>
      <GroupedResourceList lang={lang} groups={byStage} />
      <h2>{t(lang, "browseSubjectsHeading")}</h2>
      <GroupedResourceList lang={lang} groups={bySubject} />
    </>
  )
}
