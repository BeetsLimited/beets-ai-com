---
import { getCollection } from "astro:content";
import { isPublished } from "../lib/review-gate";
import { t, themesInOrder, type Locale } from "../lib/i18n";
import { assertPairedEditions, newestFirst } from "../lib/resources";
import ResourceCatalogueView from "./ResourceCatalogueView.astro";
import ThemeCardGrid from "./ThemeCardGrid.astro";

/**
 * The /resources/ page body — the catalogue, then the theme routes.
 *
 * The catalogue itself is `ResourceCatalogueView`, the shared template: this view
 * only composes it and adds what is specific to the full index. A theme page uses
 * the same template with `locked={{ theme }}`, so a visitor meets one browsing UI
 * everywhere instead of a different one per page. Renders one language only.
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const all = await getCollection("content");
assertPairedEditions(all, "resources-index");

const published = newestFirst(
  all.filter(({ data }) => isPublished(data) && data.type === "resource" && data.lang === lang),
);

/**
 * Only themes with material are linked. The theme pages all exist, so this is not
 * a broken-link question — it is that a theme route with nothing behind it is a
 * dead end for a teacher who followed it.
 */
const liveThemes = themesInOrder(lang).filter((theme) =>
  published.some((entry) => entry.data.theme === theme.key),
);
---

<ResourceCatalogueView lang={lang} />

{
  liveThemes.length > 0 ? (
    <section class="theme-routes">
      <h2>{t(lang, "resourcesThemesHeading")}</h2>
      <ThemeCardGrid lang={lang} themes={liveThemes.map((theme) => theme.key)} />
    </section>
  ) : null
}
