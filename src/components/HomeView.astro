---
import { getCollection } from "astro:content";
import { isPublished, reviewRequired } from "../lib/review-gate";
import {
  browsePath,
  feedbackPath,
  localizePath,
  resourceIndexPath,
  resourcesPath,
  t,
  themeInfo,
  themeLabel,
  themePath,
  themesInOrder,
  type Locale,
} from "../lib/i18n";
import { assertPairedEditions, newestFirst } from "../lib/resources";

/**
 * Home page body, one language only.
 *
 * Layout follows beets3d.com: a status strip (in the layout), a hero of eyebrow
 * label → large light headline → two short paragraphs → pill buttons, then
 * "start from what you need" audience cards, the five themes, the newest
 * resources and a feedback invitation. The intro paragraphs are the site's
 * statement of purpose, written for the three audiences it serves.
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const all = await getCollection("content");
// Build-time guard: an entry the loader silently discarded must break the
// build, not quietly halve the library.
assertPairedEditions(all, "home");

const published = newestFirst(all.filter(({ data }) => isPublished(data) && data.lang === lang));
const themes = themesInOrder(lang);
const newest = published.slice(0, 6);
const isZh = lang === "zh-HK";
/** Review gate off → a card must not promise a review record it has not got. */
const reviewOff = !reviewRequired();

/** The three audiences, each sent somewhere that actually helps them. */
const audiences = [
  {
    key: "teachers",
    title: isZh ? "教師" : "Teachers",
    body: isZh
      ? reviewOff
        ? "備課用得着的教案、工作紙和校本規劃範例，附答案及來源。"
        : "備課用得着的教案、工作紙和校本規劃範例，附答案、來源與審閱記錄。"
      : reviewOff
        ? "Lesson plans, worksheets and school-planning examples, with answer keys and sources."
        : "Lesson plans, worksheets and school-planning examples, with answer keys, sources and a review record.",
    href: resourceIndexPath(lang),
    link: isZh ? "瀏覽免費資源" : "Browse the free resources",
  },
  {
    key: "parents",
    title: isZh ? "家長" : "Parents",
    body: isZh
      ? "子女用 AI 做功課時，你可以怎樣引導、怎樣檢查——由家長通告到家庭功課協議。"
      : "How to guide and check AI homework at home — from a parent notice to a family homework agreement.",
    href: themePath(lang, "B"),
    link: isZh ? "安全及負責任使用 AI" : "Using AI safely and responsibly",
  },
  {
    key: "students",
    title: isZh ? "學生" : "Students",
    body: isZh
      ? "做專題前先學會核對：按科目和級別找到可用的工作紙與步驟，確認 AI 給你的答案。"
      : "For projects and for checking what an AI tells you: find worksheets and steps by subject and learning stage.",
    href: browsePath(lang),
    link: isZh ? "按科目及級別尋找" : "Find by subject and stage",
  },
];
---

<section class="hero">
  <p class="eyebrow">{t(lang, "homeEyebrow")}</p>
  <h1>{t(lang, "homeTitle")}</h1>
  <p class="lede">{t(lang, "homeLede")}</p>
  <p class="lede">{t(lang, "homeIntro2")}</p>
  <div class="btn-row">
    <a class="btn" href={resourceIndexPath(lang)}>{t(lang, "resourcesTitle")}</a>
    <a class="btn ghost" href={browsePath(lang)}>{t(lang, "homeBrowseCta")}</a>
  </div>
</section>

<section class="audiences">
  <p class="eyebrow blue">{t(lang, "homeAudienceEyebrow")}</p>
  <h2>{t(lang, "homeAudienceHeading")}</h2>
  <ul class="grid aud-grid">
    {
      audiences.map((audience) => (
        <li class={`aud aud-${audience.key}`}>
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
          <a href={audience.href}>{audience.link} →</a>
        </li>
      ))
    }
  </ul>
</section>

<section class="themes">
  <p class="eyebrow grey">{t(lang, "homeThemesEyebrow")}</p>
  <h2>{t(lang, "homeThemesHeading")}</h2>
  <p class="lede">{t(lang, "homeThemesLede")}</p>
  <ul class="grid theme-grid">
    {
      themes.map((theme) => (
        <li class="theme-card">
          <a href={themePath(lang, theme.key)}>
            <span class="badge" aria-hidden="true">
              {theme.key}
            </span>
            <h3>{theme.label}</h3>
          </a>
          <p>{themeInfo(lang, theme.key).need}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="newest">
  <p class="eyebrow grey">{t(lang, "homeNewestEyebrow")}</p>
  <h2>{t(lang, "homeNewestHeading")}</h2>
  {
    newest.length === 0 ? (
      <div class="panel">
        <p>
          <strong>{t(lang, "homeEmptyTitle")}</strong> {t(lang, "homeEmptyBody")}
        </p>
        <p>
          <a class="btn ghost" href={localizePath("/about/", lang)}>
            {t(lang, "homeEmptyCta")} →
          </a>
        </p>
      </div>
    ) : (
      <ul class="grid newest-grid">
        {newest.map((entry) => (
          <li>
            <a href={resourcesPath(lang, entry.data.address)}>{entry.data.title}</a>
            <p class="meta">
              {entry.data.stage} · {entry.data.subject} · {themeLabel(lang, entry.data.theme)}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</section>

<section class="band grey browse-band">
  <h2>{t(lang, "homeBrowseHeading")}</h2>
  <p>{t(lang, "browseLede")}</p>
  <a class="btn blue" href={browsePath(lang)}>{t(lang, "homeBrowseCta")}</a>
</section>

<section class="band feedback-band">
  <h2>{t(lang, "homeFeedbackHeading")}</h2>
  <p>{t(lang, "homeFeedbackBody")}</p>
  <a class="btn" href={feedbackPath(lang)}>{t(lang, "homeFeedbackCta")}</a>
</section>

<style>
  /* Homepage-only layout; the tokens and shared pieces live in Base. */
  .hero {
    padding-bottom: 0.5rem;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 1rem;
  }
  .aud-grid,
  .theme-grid {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .newest-grid {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .aud-grid li,
  .theme-grid li,
  .newest-grid li {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    background: var(--bg);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .aud-grid li:hover,
  .theme-grid li:hover,
  .newest-grid li:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .aud-grid h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.2rem;
  }
  .aud-grid p {
    margin: 0 0 0.75rem;
    color: #333;
    font-size: 0.95rem;
  }
  .aud-grid a {
    font-weight: 600;
    text-decoration: none;
  }
  /* A coloured rule per audience, using the two brand colours. */
  .aud-grid li {
    border-top: 4px solid var(--surface-2);
  }
  .aud-teachers {
    border-top-color: var(--accent) !important;
  }
  .aud-parents {
    border-top-color: var(--blue) !important;
  }
  .theme-card > a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .theme-card .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .theme-card h3 {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.1rem;
  }
  .theme-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .newest-grid a {
    font-weight: 600;
    text-decoration: none;
    font-size: 1.05rem;
  }
  .newest-grid .meta {
    margin: 0.35rem 0 0;
  }
  .band > .btn,
  .band > p > .btn {
    margin-top: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .aud-grid li,
    .theme-grid li,
    .newest-grid li {
      transition: none;
    }
  }
</style>
