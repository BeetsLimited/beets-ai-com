---
import { getCollection } from "astro:content";
import { isPublished, reviewRequired } from "../lib/review-gate";
import {
  browsePath,
  feedbackPath,
  localizePath,
  resourceIndexPath,
  resourcesPath,
  t,
  themeImageAlt,
  themeInfo,
  themeLabel,
  themePath,
  themesInOrder,
  type Locale,
} from "../lib/i18n";
import { assertPairedEditions, newestFirst } from "../lib/resources";

/**
 * Home page body, one language only.
 *
 * Layout follows beets3d.com: a status strip (in the layout), a hero of eyebrow
 * label → large light headline → the site illustration → two short paragraphs →
 * pill buttons, then "start from what you need" audience cards, the five themes,
 * the newest resources and a feedback invitation. The intro paragraphs are the
 * site's statement of purpose, written for the three audiences it serves.
 *
 * Every card carries a picture and its own call-to-action button. The card
 * headings are labelling text, not links — the button is the single, obvious
 * place to click (Billy, 2026-10-10). Resource cards reuse the resource's own
 * hero so the home page and the resource page show the same picture.
 *
 * Sections are separated by a thin dark-grey rule, not by a small eyebrow label,
 * and every card shares one box style — a 4px corporate-colour rule across the
 * top. "Newest resources" puts its 更多資源 button beside the heading rather
 * than under the grid (Billy, 2026-10-10).
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const all = await getCollection("content");
// Build-time guard: an entry the loader silently discarded must break the
// build, not quietly halve the library.
assertPairedEditions(all, "home");

const published = newestFirst(all.filter(({ data }) => isPublished(data) && data.lang === lang));
const themes = themesInOrder(lang);
const newest = published.slice(0, 6);
const isZh = lang === "zh-HK";
/** Review gate off → a card must not promise a review record it has not got. */
const reviewOff = !reviewRequired();

/**
 * The three audiences, each with a picture and sent somewhere that helps them.
 * Alt text describes what is actually in the illustration — it is read aloud by
 * a screen reader, so it must match the picture, not the section's intent.
 */
const audiences = [
  {
    key: "teachers",
    title: isZh ? "教師" : "Teachers",
    image: "/images/home-aud-teachers.webp",
    alt: isZh
      ? "插圖：一位教師站在課室桌前，手按一疊空白紙張，桌上有深紅色筆筒和藍色文件盤。"
      : "Illustration: a teacher standing at a classroom table with one hand on a stack of blank sheets, a deep red pencil cup and a blue paper tray on the table.",
    body: isZh
      ? reviewOff
        ? "備課用得着的教案、工作紙和校本規劃範例，附答案及來源。"
        : "備課用得着的教案、工作紙和校本規劃範例，附答案、來源與審閱記錄。"
      : reviewOff
        ? "Lesson plans, worksheets and school-planning examples, with answer keys and sources."
        : "Lesson plans, worksheets and school-planning examples, with answer keys, sources and a review record.",
    href: resourceIndexPath(lang),
    link: isZh ? "瀏覽免費資源" : "Browse the free resources",
  },
  {
    key: "parents",
    title: isZh ? "家長" : "Parents",
    image: "/images/home-aud-parents.webp",
    alt: isZh
      ? "插圖：家長與孩子並排坐在家中飯桌前，一起看一張空白紙張，桌上有平板、深紅色杯和藍色筆筒。"
      : "Illustration: a parent and child sitting side by side at a home dining table looking at one blank sheet, with a tablet, a deep red mug and a blue pencil cup.",
    body: isZh
      ? "子女用 AI 做功課時，你可以怎樣引導、怎樣檢查——由家長通告到家庭功課協議。"
      : "How to guide and check AI homework at home — from a parent notice to a family homework agreement.",
    href: themePath(lang, "B"),
    link: isZh ? "安全及負責任使用 AI" : "Using AI safely and responsibly",
  },
  {
    key: "students",
    title: isZh ? "學生" : "Students",
    image: "/images/home-aud-students.webp",
    alt: isZh
      ? "插圖：一位學生坐在書桌前，用藍色鉛筆在攤開的筆記本上書寫，桌上有深紅色筆筒。"
      : "Illustration: a student sitting at a desk writing in an open notebook with a blue pencil, with a deep red pencil cup on the desk.",
    body: isZh
      ? "做專題前先學會核對：按科目和級別找到可用的工作紙與步驟，確認 AI 給你的答案。"
      : "For projects and for checking what an AI tells you: find worksheets and steps by subject and learning stage.",
    href: browsePath(lang),
    link: isZh ? "按科目及級別尋找" : "Find by subject and stage",
  },
];
---

<section class="hero">
  <p class="eyebrow">{t(lang, "homeEyebrow")}</p>
  <h1>{t(lang, "homeTitle")}</h1>
  <img
    class="hero-art"
    src="/images/home-hero.webp"
    alt={t(lang, "homeHeroAlt")}
    width="1280"
    height="720"
    loading="eager"
    decoding="async"
  />
  <p class="lede">{t(lang, "homeLede")}</p>
  <p class="lede">{t(lang, "homeIntro2")}</p>
  <div class="btn-row">
    <a class="btn highlight" href={resourceIndexPath(lang)}>{t(lang, "resourcesTitle")}</a>
    <a class="btn" href={browsePath(lang)}>{t(lang, "homeBrowseCta")}</a>
  </div>
</section>

<hr class="section-rule" />

<section class="audiences">
  <h2>{t(lang, "homeAudienceHeading")}</h2>
  <ul class="card-grid aud-grid">
    {
      audiences.map((audience) => (
        <li class={`card aud aud-${audience.key}`}>
          <img
            class="card-art"
            src={audience.image}
            alt={audience.alt}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <h3>{audience.title}</h3>
          <p>{audience.body}</p>
          <div class="card-cta-row">
            <a class="btn card-cta" href={audience.href}>
              {audience.link}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<hr class="section-rule" />

<section class="themes">
  <h2>{t(lang, "homeThemesHeading")}</h2>
  <p class="lede">{t(lang, "homeThemesLede")}</p>
  <ul class="card-grid theme-grid">
    {
      themes.map((theme) => (
        <li class="card theme-card">
          <img
            class="card-art"
            src={`/images/home-theme-${theme.key.toLowerCase()}.webp`}
            alt={themeImageAlt(lang, theme.key)}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <span class="badge" aria-hidden="true">
            {theme.key}
          </span>
          <h3>{theme.label}</h3>
          <p>{themeInfo(lang, theme.key).need}</p>
          <div class="card-cta-row">
            <a class="btn card-cta" href={themePath(lang, theme.key)}>
              {t(lang, "cardCtaTheme")}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<hr class="section-rule" />

<section class="newest">
  <div class="section-head">
    <h2>{t(lang, "homeNewestHeading")}</h2>
    <a class="btn card-cta" href={resourceIndexPath(lang)}>{t(lang, "homeMoreResourcesCta")}</a>
  </div>
  {
    newest.length === 0 ? (
      <div class="panel">
        <p>
          <strong>{t(lang, "homeEmptyTitle")}</strong> {t(lang, "homeEmptyBody")}
        </p>
        <p>
          <a class="btn" href={localizePath("/about/", lang)}>
            {t(lang, "homeEmptyCta")} →
          </a>
        </p>
      </div>
    ) : (
      <ul class="card-grid newest-grid">
        {newest.map((entry) => (
          <li class="card resource-card">
            {entry.data.image ? (
              <img
                class="card-art"
                src={entry.data.image}
                alt={entry.data.imageAlt ?? entry.data.title}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <h3>{entry.data.title}</h3>
            <p class="meta">
              {entry.data.stage} · {entry.data.subject} · {themeLabel(lang, entry.data.theme)}
            </p>
            <div class="card-cta-row">
              <a class="btn card-cta" href={resourcesPath(lang, entry.data.address)}>
                {t(lang, "cardCtaResource")}
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>

<section class="band grey browse-band">
  <h2>{t(lang, "homeBrowseHeading")}</h2>
  <p>{t(lang, "browseLede")}</p>
  <a class="btn" href={browsePath(lang)}>{t(lang, "homeBrowseCta")}</a>
</section>

<section class="band feedback-band">
  <h2>{t(lang, "homeFeedbackHeading")}</h2>
  <p>{t(lang, "homeFeedbackBody")}</p>
  <a class="btn" href={feedbackPath(lang)}>{t(lang, "homeFeedbackCta")}</a>
</section>

<style>
  /* Homepage-only layout; the tokens and shared pieces live in Base. */
  .hero {
    padding-bottom: 0.5rem;
  }
  /* The site illustration sits directly under the headline, above the lede. */
  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.35rem 0 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* The card box, the grid and the CTA all come from the layout's `.card` /
     `.card-grid` / `.card-cta`, so the homepage and the resource catalogue render
     the same card. Only the column count is the homepage's own business. */
  /* Desktop: three across, so the six newest resources read as two even rows. */
  .newest-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* The three section headings that carry the corporate colour. The rule above
     each one is what separates the sections now the eyebrow labels are gone, so
     the heading does not add a large top margin of its own on top of it. */
  .audiences h2,
  .themes h2,
  .newest h2 {
    color: var(--corporate);
    margin-top: 1.5rem;
  }
  .section-rule {
    border: 0;
    border-top: 1px solid var(--divider);
    margin: 2.4rem 0 0;
  }
  /* A heading with its CTA on the same line: 最新資源 + 更多資源. */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .aud-grid h3,
  .theme-card h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.2rem;
  }
  .aud-grid p {
    margin: 0 0 0.75rem;
    color: #333;
    font-size: 0.95rem;
  }
  .theme-card .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .theme-card h3 {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.1rem;
  }
  .theme-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .newest-grid h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .newest-grid .meta {
    margin: 0;
  }
  .band > .btn,
  .band > p > .btn {
    margin-top: 0.5rem;
  }
  /* Narrower than the container's own max width: 3 across stops fitting well
     before the layout itself collapses. */
  @media (max-width: 48rem) {
    .newest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .newest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
