---
import { getCollection } from "astro:content";
import { isPublished } from "../lib/review-gate";
import {
  feedbackPath,
  localizePath,
  resourceIndexPath,
  resourcesPath,
  t,
  themeLabel,
  themesInOrder,
  type Locale,
} from "../lib/i18n";
import { assertPairedEditions, newestFirst } from "../lib/resources";
import { ORG_SITE } from "../lib/seo";
import { AUDIENCES } from "../lib/schema";
import AudienceCardGrid from "./AudienceCardGrid.astro";
import ThemeCardGrid from "./ThemeCardGrid.astro";

/**
 * Home page body, one language only.
 *
 * Layout follows beets3d.com: a status strip (in the layout), a hero of eyebrow
 * label → large light headline → the site illustration → two short paragraphs →
 * pill buttons, then "start from what you need" audience cards, the five themes,
 * the newest resources and a feedback invitation. The intro paragraphs are the
 * site's statement of purpose, written for the three audiences it serves.
 *
 * Every card carries a picture and its own call-to-action button. The card
 * headings are labelling text, not links — the button is the single, obvious
 * place to click (Billy, 2026-10-10). Resource cards reuse the resource's own
 * hero so the home page and the resource page show the same picture.
 *
 * Sections are separated by a thin dark-grey rule, not by a small eyebrow label,
 * and every card shares one box style — a 4px corporate-colour rule across the
 * top. "Newest resources" puts its 更多資源 button beside the heading rather
 * than under the grid (Billy, 2026-10-10).
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const all = await getCollection("content");
// Build-time guard: an entry the loader silently discarded must break the
// build, not quietly halve the library.
assertPairedEditions(all, "home");

const published = newestFirst(all.filter(({ data }) => isPublished(data) && data.lang === lang));
const themes = themesInOrder(lang);
const newest = published.slice(0, 6);

---

<section class="hero">
  <p class="eyebrow">{t(lang, "homeEyebrow")}</p>
  <h1>{t(lang, "homeTitle")}</h1>
  <img
    class="hero-art"
    src="/images/home-hero.webp"
    alt={t(lang, "homeHeroAlt")}
    width="1280"
    height="720"
    loading="eager"
    decoding="async"
  />
  <p class="lede">
    {t(lang, "homeLedeBefore")}<a href={ORG_SITE} target="_blank" rel="noopener noreferrer"
      >Beets Limited</a
    >{t(lang, "homeLedeAfter")}
  </p>
  <p class="lede">{t(lang, "homeIntro2")}</p>
  <div class="btn-row">
    <a class="btn highlight" href={resourceIndexPath(lang)}>{t(lang, "resourcesTitle")}</a>
    {/* Internal, so it navigates in place, and the path is localised: an English
        reader stays in the English edition (Billy, 2026-10-11). */}
    <a class="btn" href={localizePath("/about/", lang)}>{t(lang, "homeAboutCta")}</a>
  </div>
</section>

<hr class="section-rule" />

<section class="audiences">
  <h2>{t(lang, "homeAudienceHeading")}</h2>
  {/* One component, three callers: the same cards render here, on /resources/
      and on each audience page (Billy, 2026-10-11). */}
  <AudienceCardGrid lang={lang} audiences={[...AUDIENCES]} />
</section>

<hr class="section-rule" />

<section class="themes">
  <h2>{t(lang, "homeThemesHeading")}</h2>
  <p class="lede">{t(lang, "homeThemesLede")}</p>
  <ThemeCardGrid lang={lang} themes={themes.map((theme) => theme.key)} />
</section>

<hr class="section-rule" />

<section class="newest">
  <div class="section-head">
    <h2>{t(lang, "homeNewestHeading")}</h2>
    <a class="btn card-cta" href={resourceIndexPath(lang)}>{t(lang, "homeMoreResourcesCta")}</a>
  </div>
  {
    newest.length === 0 ? (
      <div class="panel">
        <p>
          <strong>{t(lang, "homeEmptyTitle")}</strong> {t(lang, "homeEmptyBody")}
        </p>
        <p>
          <a class="btn" href={localizePath("/about/", lang)}>
            {t(lang, "homeEmptyCta")} →
          </a>
        </p>
      </div>
    ) : (
      <ul class="card-grid newest-grid">
        {newest.map((entry) => (
          <li class="card resource-card">
            {entry.data.image ? (
              <img
                class="card-art"
                src={entry.data.image}
                alt={entry.data.imageAlt ?? entry.data.title}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <h3>{entry.data.title}</h3>
            <p class="meta">
              {entry.data.stage} · {entry.data.subject} · {themeLabel(lang, entry.data.theme)}
            </p>
            <div class="card-cta-row">
              <a class="btn card-cta" href={resourcesPath(lang, entry.data.address)}>
                {t(lang, "cardCtaResource")}
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>

<section class="band feedback-band">
  <h2>{t(lang, "homeFeedbackHeading")}</h2>
  <p>{t(lang, "homeFeedbackBody")}</p>
  <a class="btn" href={feedbackPath(lang)}>{t(lang, "homeFeedbackCta")}</a>
</section>

<style>
  /* Homepage-only layout; the tokens and shared pieces live in Base. */
  .hero {
    padding-bottom: 0.5rem;
  }
  /* The site illustration sits directly under the headline, above the lede. */
  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.35rem 0 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* The card box, the grid and the CTA all come from the layout's `.card` /
     `.card-grid` / `.card-cta`, so the homepage and the resource catalogue render
     the same card. Only the column count is the homepage's own business. */
  /* Desktop: three across, so the six newest resources read as two even rows. */
  .newest-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* The three section headings that carry the corporate colour. The rule above
     each one is what separates the sections now the eyebrow labels are gone, so
     the heading does not add a large top margin of its own on top of it. */
  .audiences h2,
  .themes h2,
  .newest h2 {
    color: var(--corporate);
    margin-top: 1.5rem;
  }
  .section-rule {
    border: 0;
    border-top: 1px solid var(--divider);
    margin: 2.4rem 0 0;
  }
  /* A heading with its CTA on the same line: 最新資源 + 更多資源. */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .newest-grid h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .newest-grid .meta {
    margin: 0;
  }
  .band > .btn,
  .band > p > .btn {
    margin-top: 0.5rem;
  }
  /* Narrower than the container's own max width: 3 across stops fitting well
     before the layout itself collapses. */
  @media (max-width: 48rem) {
    .newest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .newest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
