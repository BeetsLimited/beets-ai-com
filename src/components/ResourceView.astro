---
import { render, type CollectionEntry } from "astro:content";
import { audienceLabel, audiencePath, resourcesPath, t, themeLabel, type Locale } from "../lib/i18n";
import { pageFacts } from "../lib/resource-facts";

/**
 * One resource page, in one language.
 *
 * `lang` is the language of the page being built; the entry itself carries its
 * own language, so the two are always the same edition. There is no separate
 * review rendering: this IS the published page.
 *
 * The page is deliberately thin. The content owns its seven sections — and the
 * middle three of those adapt to the resource's `kind`, so a whole-school
 * planning template gets "規劃目標 / 規劃步驟 / 檢核要點" rather than being
 * called a lesson (`../lib/resource-kinds.ts`). This view adds only what the
 * content does not: the hero, the classification block, the practical details,
 * same-theme siblings and the reuse terms.
 *
 * **No internal record is rendered here.** `sourceIdea`, `sources`, `reviewer`,
 * `factCheckedBy`, `factCheckedOn` and any `[[VERIFY]]` note stay in the entry
 * as provenance and audit trail — the numbers, the source codes and the
 * reviewer's name are working records, not something a teacher needs to read
 * (Billy, 2026-10-10). They stay in the entry as the internal audit trail, and
 * `npm run check:public-copy` fails the build if one ever reaches `dist/`.
 */
interface Props {
  entry: CollectionEntry<"content">;
  lang: Locale;
  /** Same-theme siblings, supplied by the route. */
  related?: { address: string; title: string }[];
}

const { entry, lang, related = [] } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
/** A calendar date as a reader reads it: one format in both editions. */
const isoDate = (value: Date | string) => new Date(value).toISOString().slice(0, 10);

/**
 * The five facts that answer "is this a teaching resource for me?" — 學習階段 ·
 * 科目 · 學習範疇 · 對應官方文件 · 一節時間 (Henry, 2026-10-17: a teacher
 * sampling five pages found four whose first 300 characters named no official
 * document at all). They print above the lede, so they are the first thing on
 * the page after the heading.
 *
 * The strand and the document titles are read out of the page's own 官方文件
 * 參考 section rather than typed here — see `../lib/resource-facts.ts`.
 */
const facts = pageFacts(d, entry.body ?? "", lang);
const factsRows = [
  { label: t(lang, "labelStage"), value: facts.stage },
  { label: t(lang, "labelSubject"), value: facts.subject },
  { label: t(lang, "labelStrand"), value: facts.strand },
  { label: t(lang, "labelDocs"), value: facts.documents.join(" · ") || undefined },
  { label: t(lang, "labelSessionTime"), value: facts.time },
].filter((row): row is { label: string; value: string } => Boolean(row.value));

/**
 * The browsing lines below the hero. Stage and subject moved UP into the facts
 * block, and preparation time with them, so no page prints the same value twice
 * on one screen.
 */
const classification = [
  // The theme's public name. The A–E key is internal lettering, not for a reader.
  { label: t(lang, "labelTheme"), value: themeLabel(lang, d.theme) },
].filter((row) => Boolean(row.value));

const practicals = [
  d.equipment ? { label: t(lang, "labelEquipment"), value: d.equipment } : null,
  { label: t(lang, "labelVersion"), value: d.version },
  /**
   * The last-modified date, beside the version (Henry, 2026-10-17). `updated`
   * is written only when a page really was changed after publication; an entry
   * that never was has no edit to report, so it shows its publication date
   * rather than a blank or a claim.
   */
  { label: t(lang, "labelUpdated"), value: isoDate(d.updated ?? d.date) },
].filter((row): row is { label: string; value: string } => row !== null);
---

<article>
  <h1>{d.title}</h1>

  {/* 五行：學習階段 · 科目 · 學習範疇 · 對應官方文件 · 一節時間 */}
  <ul class="facts">
    {
      factsRows.map((row) => (
        <li>
          <span class="facts-k">{row.label}</span>
          <span class="facts-v">{row.value}</span>
        </li>
      ))
    }
  </ul>

  <p>{d.description}</p>

  {
    d.image ? (
      <figure class="hero">
        <img
          src={d.image}
          alt={d.imageAlt ?? d.title}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : null
  }

  {/*
    分類：主題 / 對象 / 年級 / 範疇。 One line each, label in a fixed column.
     The audience is the one that links: each value is a browsing route (its own
    index page), so it behaves like a link rather than dead text.
  */}
  <ul class="spec">
    <li>
      <span class="spec-k">{t(lang, "labelAudience")}</span>
      <span class="spec-v">
        {
          d.audience.map((key, index) => (
            <>
              <a href={audiencePath(lang, key)}>{audienceLabel(lang, key)}</a>
              {index < d.audience.length - 1 ? " " : null}
            </>
          ))
        }
      </span>
    </li>
    {
      classification.map((row) => (
        <li>
          <span class="spec-k">{row.label}</span>
          <span class="spec-v">{row.value}</span>
        </li>
      ))
    }
  </ul>

  <ul class="practical">
    {
      practicals.map((row) => (
        <li>
          <span class="practical-k">{row.label}</span>
          <span class="practical-v">{row.value}</span>
        </li>
      ))
    }
  </ul>

  <Content />

  {
    related.length > 0 ? (
      <section>
        <h2>{t(lang, "relatedHeading")}</h2>
        <ul>
          {related.map((other) => (
            <li>
              <a href={resourcesPath(lang, other.address)}>{other.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section>
    <h2>{t(lang, "reuseHeading")}</h2>
    <p>{t(lang, "reuseBody")}</p>
  </section>
</article>

<style>
  /*
    Scoped to this component on purpose. A view's OWN class rules work scoped —
    it was the layout's shared design system that had to be made global in
    Base.astro, because that markup is rendered through a slot by these views.
  */
  .hero {
    margin: 1.5rem 0 1.8rem;
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface, #f3f3f3);
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    The five-line answer. Deliberately the first thing under the h1: a teacher
    deciding whether this page is a lesson for their class reads it before the
    lede (Henry, 2026-10-17).
  */
  .facts {
    list-style: none;
    margin: 1.1rem 0 1.4rem;
    padding: 0.9rem 1.25rem;
    display: grid;
    gap: 0.35rem;
    background: var(--surface, #f3f3f3);
    border-left: 4px solid var(--corporate, #e10707);
    border-radius: 0 var(--radius, 18px) var(--radius, 18px) 0;
  }
  .facts li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.9rem;
    align-items: baseline;
    font-size: 0.95rem;
  }
  .facts-k {
    color: var(--muted, #6f6f6f);
    font-weight: 600;
    white-space: nowrap;
  }
  .facts-v {
    color: var(--ink, #080808);
  }

  .spec,
  .practical {
    list-style: none;
    margin: 1.4rem 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .spec {
    background: var(--surface, #f3f3f3);
    border-radius: var(--radius, 18px);
    padding: 1.1rem 1.35rem;
  }
  .spec li,
  .practical li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.9rem;
    align-items: baseline;
  }
  .spec li {
    font-size: 0.98rem;
  }
  .practical li {
    font-size: 0.9rem;
  }
  .spec-k,
  .practical-k {
    color: var(--muted, #6f6f6f);
    font-weight: 600;
  }
  .spec-v {
    color: var(--ink, #080808);
  }
  .practical-v {
    color: var(--muted, #6f6f6f);
  }
  /* A phone has no room for a 7rem label column and a value. */
  @media (max-width: 30rem) {
    .facts li,
    .spec li,
    .practical li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
