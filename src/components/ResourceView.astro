---
import { render, type CollectionEntry } from "astro:content";
import { resourcesPath, t, themeLabel, type Locale } from "../lib/i18n";
import { reviewRequired } from "../lib/review-gate";

/**
 * One resource page, in one language.
 *
 * `lang` is the language of the page being built; the entry itself carries its
 * own language, so the two are always the same edition. Shared by the public
 * route and the internal review route, so what a reviewer sees is what ships.
 *
 * The page is deliberately thin. The content owns its seven sections — and the
 * middle three of those adapt to the resource's `kind`, so a whole-school
 * planning template gets "規劃目標 / 規劃步驟 / 檢核要點" rather than being
 * called a lesson (`../lib/resource-kinds.ts`). This view adds only what the
 * content does not: the hero, the classification block, the practical details,
 * same-theme siblings and the reuse terms.
 *
 * **No internal record is rendered here.** `sourceIdea`, `sources`, `reviewer`,
 * `factCheckedBy`, `factCheckedOn` and any `[[VERIFY]]` note stay in the entry
 * as provenance and audit trail — the numbers, the source codes and the
 * reviewer's name are working records, not something a teacher needs to read
 * (Billy, 2026-10-10). They are visible where they belong: `/review/`.
 */
interface Props {
  entry: CollectionEntry<"content">;
  lang: Locale;
  /** Review mode adds the unreviewed-draft banner. */
  reviewMode?: boolean;
  /** Same-theme siblings, supplied by the route (empty in the review area). */
  related?: { address: string; title: string }[];
}

const { entry, lang, reviewMode = false, related = [] } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
/**
 * The draft warning follows the `draft` flag, so publishing removes it — and it
 * is suppressed entirely while the review gate is off, because those pages are
 * published at their public URLs on purpose.
 */
const showDraftNotice = reviewMode || (reviewRequired() && d.draft);

/** The three classification lines, in the order the page reads them. */
const classification = [
  { label: t(lang, "labelTheme"), value: `${d.theme} · ${themeLabel(lang, d.theme)}` },
  { label: t(lang, "labelStage"), value: d.stage },
  { label: t(lang, "labelSubject"), value: d.subject },
].filter((row) => Boolean(row.value));

const practicals = [
  d.prepTime ? { label: t(lang, "labelPrep"), value: d.prepTime } : null,
  d.equipment ? { label: t(lang, "labelEquipment"), value: d.equipment } : null,
  { label: t(lang, "labelVersion"), value: d.version },
].filter((row): row is { label: string; value: string } => row !== null);
---

<article>
  {
    showDraftNotice ? (
      <div class="notice">
        <strong>⚠️ 草稿 · 未經審閱 — DRAFT, NOT REVIEWED</strong>
        <p>
          此頁僅供內部審閱。尚未完成事實核實及教育工作者審閱，因此<strong>未在正式網址發佈</strong>，
          亦已排除於搜尋引擎之外。
        </p>
        <p class="muted">
          For internal review only. Not yet fact-checked or educator-reviewed, so it is not
          published at its public URL and is excluded from search engines.
        </p>
      </div>
    ) : null
  }

  <h1>{d.title}</h1>

  <p>{d.description}</p>

  {
    d.image ? (
      <figure class="hero">
        <img
          src={d.image}
          alt={d.imageAlt ?? d.title}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : null
  }

  {/* 三行分類：主題 / 年級 / 範疇。 One line each, label in a fixed column. */}
  <ul class="spec">
    {
      classification.map((row) => (
        <li>
          <span class="spec-k">{row.label}</span>
          <span class="spec-v">{row.value}</span>
        </li>
      ))
    }
  </ul>

  <ul class="practical">
    {
      practicals.map((row) => (
        <li>
          <span class="practical-k">{row.label}</span>
          <span class="practical-v">{row.value}</span>
        </li>
      ))
    }
  </ul>

  <Content />

  {
    related.length > 0 ? (
      <section>
        <h2>{t(lang, "relatedHeading")}</h2>
        <ul>
          {related.map((other) => (
            <li>
              <a href={resourcesPath(lang, other.address)}>{other.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section>
    <h2>{t(lang, "reuseHeading")}</h2>
    <p>{t(lang, "reuseBody")}</p>
  </section>
</article>

<style>
  /*
    Scoped to this component on purpose. A view's OWN class rules work scoped —
    it was the layout's shared design system that had to be made global in
    Base.astro, because that markup is rendered through a slot by these views.
  */
  .hero {
    margin: 1.5rem 0 1.8rem;
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface, #f3f3f3);
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .spec,
  .practical {
    list-style: none;
    margin: 1.4rem 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .spec {
    background: var(--surface, #f3f3f3);
    border-radius: var(--radius, 18px);
    padding: 1.1rem 1.35rem;
  }
  .spec li,
  .practical li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.9rem;
    align-items: baseline;
  }
  .spec li {
    font-size: 0.98rem;
  }
  .practical li {
    font-size: 0.9rem;
  }
  .spec-k,
  .practical-k {
    color: var(--muted, #6f6f6f);
    font-weight: 600;
  }
  .spec-v {
    color: var(--ink, #080808);
  }
  .practical-v {
    color: var(--muted, #6f6f6f);
  }
  /* A phone has no room for a 7rem label column and a value. */
  @media (max-width: 30rem) {
    .spec li,
    .practical li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
