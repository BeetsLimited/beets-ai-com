---
import { render, type CollectionEntry } from "astro:content";
import { resourcesPath, t, themeLabel, type Locale } from "../lib/i18n";

/**
 * One resource page, in one language.
 *
 * `lang` is the language of the page being built; the entry itself carries its
 * own language, so the two are always the same edition. Shared by the public
 * route and the internal review route, so what a reviewer sees is what ships.
 */
interface Props {
  entry: CollectionEntry<"content">;
  lang: Locale;
  /** Review mode adds the unreviewed-draft banner. */
  reviewMode?: boolean;
  /** Same-theme siblings, supplied by the route (empty in the review area). */
  related?: { address: string; title: string }[];
}

const { entry, lang, reviewMode = false, related = [] } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
/** The draft warning follows the `draft` flag, so publishing removes it. */
const showDraftNotice = reviewMode || d.draft;
---

<article>
  {
    showDraftNotice ? (
      <div class="notice">
        <strong>⚠️ 草稿 · 未經審閱 — DRAFT, NOT REVIEWED</strong>
        <p>
          此頁僅供內部審閱。尚未完成事實核實及教育工作者審閱，因此<strong>未在正式網址發佈</strong>，
          亦已排除於搜尋引擎之外。
        </p>
        <p class="muted">
          For internal review only. Not yet fact-checked or educator-reviewed, so it is not
          published at its public URL and is excluded from search engines.
        </p>
      </div>
    ) : null
  }

  <h1>{d.title}</h1>

  <p class="meta">
    {t(lang, "labelTheme")} {d.theme} · {themeLabel(lang, d.theme)} · {d.stage} · {d.subject}
    {d.sourceIdea ? ` · ${t(lang, "labelOriginalIdea")} ${d.sourceIdea}` : ""}
  </p>

  <p>{d.description}</p>

  <dl class="meta">
    {d.prepTime ? <><dt>{t(lang, "labelPrep")}</dt><dd>{d.prepTime}</dd></> : null}
    {d.equipment ? <><dt>{t(lang, "labelEquipment")}</dt><dd>{d.equipment}</dd></> : null}
    <dt>{t(lang, "labelVersion")}</dt>
    <dd>{d.version}</dd>
    {
      d.reviewer ? (
        <>
          <dt>{t(lang, "labelReviewer")}</dt>
          <dd>{d.reviewer}</dd>
        </>
      ) : null
    }
    {
      d.factCheckedBy ? (
        <>
          <dt>{t(lang, "labelFactCheck")}</dt>
          <dd>{d.factCheckedBy}</dd>
        </>
      ) : null
    }
  </dl>

  <Content />

  <section>
    <h2>{t(lang, "downloadsHeading")}</h2>
    {
      d.downloads.length === 0 ? (
        <p>{t(lang, "downloadsPending")}</p>
      ) : (
        <ul>
          {d.downloads.map((file) => (
            <li>
              <a href={file}>{file.split("/").pop()}</a> <span class="meta">{t(lang, "downloadNote")}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <h2>{t(lang, "edbHeading")}</h2>
    <ul>
      {d.sources.map((source) => (
        <li>{source}</li>
      ))}
    </ul>
    <p class="meta">
      {t(lang, "edbOfficialDoc")}{" "}
      <a
        href="https://www.edb.gov.hk/en/edu-system/primary-secondary/applicable-to-primary-secondary/it-in-edu/debp.html"
        rel="noopener"
      >
        {t(lang, "debpLinkText")}
      </a>
    </p>
  </section>

  {
    related.length > 0 ? (
      <section>
        <h2>{t(lang, "relatedHeading")}</h2>
        <ul>
          {related.map((other) => (
            <li>
              <a href={resourcesPath(lang, other.address)}>{other.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section>
    <h2>{t(lang, "reuseHeading")}</h2>
    <p>{t(lang, "reuseBody")}</p>
  </section>

  {
    d.feedback ? (
      <section>
        <h2>{t(lang, "feedbackHeading")}</h2>
        <p>{t(lang, "feedbackBody")}</p>
      </section>
    ) : null
  }
</article>
