---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"content">;
  /** Review mode adds the unreviewed-draft banner and the reviewer checklist. */
  reviewMode?: boolean;
}

const { entry, reviewMode = false } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<article>
  {
    reviewMode ? (
      <div class="notice">
        <strong>⚠️ 草稿 · 未經審閱 — DRAFT, NOT REVIEWED</strong>
        <p>
          此頁僅供內部審閱。尚未完成事實核實及教育工作者審閱，因此<strong>未在正式網址發佈</strong>，
          亦已排除於搜尋引擎之外。
        </p>
        <p class="muted">
          For internal review only. Not yet fact-checked or educator-reviewed, so it is not
          published at its public URL and is excluded from search engines.
        </p>
      </div>
    ) : null
  }

  <p class="meta">
    Theme {d.theme} · {d.stage} · {d.subject}
    {d.sourceIdea ? ` · 原始構思 ${d.sourceIdea}` : ""}
  </p>
  <h1>{d.title}</h1>
  {d.title_en ? <p class="meta">{d.title_en}</p> : null}

  <p>{d.description}</p>

  <dl class="meta">
    {d.prepTime ? <><dt>準備時間 Preparation</dt><dd>{d.prepTime}</dd></> : null}
    {d.equipment ? <><dt>所需器材 Equipment</dt><dd>{d.equipment}</dd></> : null}
    <dt>版本 Version</dt>
    <dd>{d.version}</dd>
    {
      d.reviewer ? (
        <>
          <dt>審閱 Reviewer</dt>
          <dd>{d.reviewer}</dd>
        </>
      ) : null
    }
    {
      d.factCheckedBy ? (
        <>
          <dt>事實核實 Fact-checked by</dt>
          <dd>{d.factCheckedBy}</dd>
        </>
      ) : null
    }
  </dl>

  <Content />

  <section>
    <h2>下載 Downloads</h2>
    {
      d.downloads.length === 0 ? (
        <p>檔案準備中。Files are being prepared.</p>
      ) : (
        <ul>
          {d.downloads.map((file) => (
            <li>
              <a href={file}>{file.split("/").pop()}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <h2>與 EDB 框架的關係 How this relates to the EDB framework</h2>
    <ul>
      {d.sources.map((source) => (
        <li>{source}</li>
      ))}
    </ul>
    <p class="meta">
      官方文件：
      <a
        href="https://www.edb.gov.hk/en/edu-system/primary-secondary/applicable-to-primary-secondary/it-in-edu/debp.html"
        rel="noopener"
      >
        EDB 數字教育 Digital Education Blueprint
      </a>
    </p>
  </section>

  {
    d.feedback ? (
      <section>
        <h2>意見 Feedback</h2>
        <p>你用過這份資源嗎？歡迎告訴我們需要改善的地方，或建議下一份資源。</p>
      </section>
    ) : null
  }
</article>
