---
import {
  audienceImageAlt,
  audienceImagePath,
  audienceInfo,
  audiencesInOrder,
  resourceIndexPath,
  t,
  type Locale,
} from "../lib/i18n";
import { audiencePageCopy } from "../lib/audience-pages";
import type { Audience } from "../lib/schema";
import AudienceCardGrid from "./AudienceCardGrid.astro";
import ResourceCatalogueView from "./ResourceCatalogueView.astro";

/**
 * An audience page (對象) — one of the three, and the same six elements in the
 * same order as a theme page (Billy, 2026-10-11: "similar to the 5 theme pages"):
 *
 *   1. the heading       — 「教師適用的資源」 (AUDIENCE_INFO.heading)
 *   2. the sub-title     — the one-sentence need this audience has
 *   3. a hero image      — the audience's own home-page illustration, so the card
 *                          a visitor clicked and the page they landed on match
 *   4. the description   — long-form, written for search (src/lib/audience-pages.ts)
 *   5. the resource catalogue, locked to this audience
 *   6. the FAQs          — the questions this audience actually asks
 *
 * Elements 1, 2 and 5 come from the catalogue template, which owns the h1 and the
 * locked criteria; the hero and the description are slotted between them so the
 * order above is the DOM order. Elements 4 and 6 are absent for an audience whose
 * copy has not been written yet — the page still renders and is still useful.
 */
interface Props {
  lang: Locale;
  audience: Audience;
}

const { lang, audience } = Astro.props;

const info = audienceInfo(lang, audience);
const copy = audiencePageCopy(lang, audience);
const heroImage = audienceImagePath(audience);
/** The other two, so a reader who landed in the wrong place can move sideways. */
const otherAudiences = audiencesInOrder(lang)
  .map((entry) => entry.key)
  .filter((key) => key !== audience);
---

<p class="audience-back">
  <a href={resourceIndexPath(lang)}>{t(lang, "themeBackToAll")}</a>
</p>

<ResourceCatalogueView
  lang={lang}
  heading={info.heading}
  lede={info.need}
  locked={{ audience }}
>
  <figure class="audience-hero">
    <img
      src={heroImage}
      alt={audienceImageAlt(lang, audience)}
      width="1280"
      height="720"
      loading="eager"
      decoding="async"
    />
  </figure>

  {
    copy ? (
      <div class="audience-intro">
        {copy.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    ) : null
  }
</ResourceCatalogueView>

{
  copy ? (
    <section class="audience-faqs">
      <h2>{t(lang, "themeFaqHeading")}</h2>
      {copy.faqs.map((faq) => (
        <div class="faq">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </section>
  ) : null
}

<section class="audience-others">
  <h2>{t(lang, "resourcesAudiencesHeading")}</h2>
  <AudienceCardGrid lang={lang} audiences={otherAudiences} />
</section>

<style>
  .audience-back {
    margin: 0 0 0.75rem;
  }
  .audience-back a {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .audience-back a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .audience-hero {
    margin: 1.1rem 0 1.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .audience-hero img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The searchable description: prose, one paragraph per idea, at a comfortable
     measure — this is the text a search engine or an answer engine quotes. */
  .audience-intro {
    margin: 0 0 1.75rem;
  }
  .audience-intro p {
    margin: 0 0 0.9rem;
    color: #333;
  }
  .audience-faqs {
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--divider);
    padding-top: 1.75rem;
  }
  .audience-faqs h2 {
    margin-top: 0;
  }
  .faq {
    margin: 0 0 1.35rem;
  }
  .faq h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .faq p {
    margin: 0;
    color: #333;
  }
  .audience-others {
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--divider);
    padding-top: 1.75rem;
  }
  .audience-others h2 {
    margin-top: 0;
  }
</style>
