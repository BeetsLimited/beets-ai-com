---
import { audienceLabel, audiencePath, feedbackPath, t, type Locale } from "../lib/i18n";
import { ORG_SITE } from "../lib/seo";

/**
 * About page body (rewritten 2026-10-11, Billy).
 *
 * Because it is the page a stranger, a search engine and an AI answer engine
 * read to decide what this site IS, it is written as a direct, quotable
 * statement: what the library is, who it is for, why we build it, who Beets is,
 * how the material relates to the official documents, the reuse terms, and a way
 * to reach us. Nothing else.
 *
 * **No internal material — this is the page that carried the most of it.**
 * Billy, 2026-10-11: *"remove all content about internal process and information
 * and do not use any internal reference codes like B, F, G, E for the reference
 * document. In future, NEVER put any internal processing notes or information in
 * customer facing website."* So: no editorial pipeline, no build or link-check
 * talk, no review-area URL, no source-code table (the documents are named by
 * their published titles instead), no reviewer names, no version-of-record
 * fields. `scripts/check-public-copy.mjs` fails the build if any of that
 * reappears on a public page.
 *
 * Both editions live here, but only one is ever rendered — Astro evaluates the
 * branch at build time, so the built page contains a single language.
 * `npm run check:lang` enforces that.
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

/** Parent department page, so a reader can reach the documents we draw on. */
const EDB_BLUEPRINT =
  "https://www.edb.gov.hk/en/edu-system/primary-secondary/applicable-to-primary-secondary/it-in-edu/debp.html";
const AUDIENCES = ["teachers", "parents", "students"] as const;
---

{
  lang === "zh-HK" ? (
    <>
      <h1>關於 Beets AI</h1>

      <p class="lead">
        Beets AI 是 Beets Limited 為香港教師、家長和學生設立的<strong>免費 AI 教育資源庫</strong>
        ：教案、工作紙、校本規劃範例與評估任務，全部免費下載、不需註冊。
      </p>

      <h2>這個網站是什麼</h2>
      <p>
        Beets AI 是一個免費的香港 AI 教學資源庫。每份資源對應一個具體的教學需要——某一級、某一科、某一項課堂任務——而不是泛泛的主題；內容包括可以直接編輯的教案、工作紙、校本規劃範例與評估任務，附件以 Word、Excel 或 PowerPoint
        格式提供，下載後即可按校情修改。每份資源都有繁體中文及英文版本。
      </p>
      <p>
        資源參考教育局已發布的官方文件，例如《中小學人工智能素養學習架構》與{" "}
        <a href={EDB_BLUEPRINT} target="_blank" rel="noopener noreferrer">{t(lang, "debpLinkText")}</a>
        ，並在每份資源列明它依據哪份文件，方便你回到原始資料核對。本網站是 Beets
        的獨立計劃，<strong>並非教育局官方文件</strong>；教材的內容與判斷由我們負責。
      </p>

      <h2>給教師、家長和學生</h2>
      <ul class="cards">
        {AUDIENCES.map((audience) => (
          <li>
            <a href={audiencePath(lang, audience)}>{audienceLabel(lang, audience)}</a>
            <p class="meta">
              {audience === "teachers"
                ? "備課、施教與校本規劃：教案、工作紙、課程覆蓋分析與評估工具。"
                : audience === "parents"
                  ? "在家引導子女用 AI 做功課：親子活動、家庭功課協議與家長通告。"
                  : "做專題與核對 AI 答案：可以直接使用的工作紙、步驟與紀錄表。"}
            </p>
          </li>
        ))}
      </ul>

      <h2>為什麼我們做這個網站</h2>
      <p>
        學好 AI 不應該取決於學校有多少預算，或者家長懂不懂技術。課堂上真正花時間的一步，是把官方文件與指引變成明天就可以用的教材——我們把這一步做完，讓教師、家長和學生直接下載使用。如果這裡沒有你需要的材料，歡迎
        <a href={feedbackPath(lang)}>告訴我們</a>，我們會優先製作。
      </p>

      <h2>關於 Beets Limited</h2>
      <p>
        Beets Limited 是香港的創意科技教育公司。我們以 AI、3D 設計及 3D
        打印，協助學校、家庭、企業及創作者把意念變成成品：學校 STEM 課程、3D 與 AI
        創意工作坊、3D 設計及打印服務，以及相關設備與耗材。
      </p>
      <p>
        這個資源庫是同一份工作的另一面。我們把在課室與工作坊累積下來的做法，整理成任何人都可以下載使用的教材。想了解我們的課程、服務與產品，請到
        beets3d.com。
      </p>
      <p>
        <a class="btn" href={ORG_SITE} target="_blank" rel="noopener noreferrer">
          beets3d.com →
        </a>
      </p>

      <h2>使用條款與私隱</h2>
      <ul>
        <li>資源可免費下載，供教學使用及改編；請保留來源標示。</li>
        <li>如引用第三方教材，我們會連結原始來源。</li>
        <li>本站不收集學生作品，也不收集任何可識別學生身分的資料。</li>
        <li>下載不需註冊；如你留下電郵，只會在取得同意後用作通知新資源。</li>
        <li>
          我們以 Google Analytics 統計整體的瀏覽次數與下載次數，只知道哪些資源被使用，不會識別個別讀者。
        </li>
      </ul>
    </>
  ) : (
    <>
      <h1>About Beets AI</h1>

      <p class="lead">
        Beets AI is a <strong>free library of AI teaching resources</strong> that Beets Limited
        builds for Hong Kong teachers, parents and students — lesson plans, worksheets,
        school-planning examples and assessment tasks, all free to download and with no
        registration.
      </p>

      <h2>What this site is</h2>
      <p>
        Beets AI is a free library of Hong Kong AI teaching resources. Each resource answers one
        specific teaching need — a learning stage, a subject, a classroom task — rather than a vague
        theme. The material includes editable lesson plans, worksheets, school-planning examples and
        assessment tasks, provided as Word, Excel or PowerPoint files you can adapt to your own
        school. Every resource exists in Traditional Chinese and in English.
      </p>
      <p>
        The material draws on official documents published by the Education Bureau, such as the AI
        Literacy Learning Framework for Primary and Secondary Schools and the{" "}
        <a href={EDB_BLUEPRINT} target="_blank" rel="noopener noreferrer">{t(lang, "debpLinkText")}</a>, and every resource
        names the document it is built on so you can check it at source. This site is an independent
        initiative by Beets and is <strong>not an official EDB publication</strong>; the teaching
        material and the judgements in it are ours.
      </p>

      <h2>For teachers, parents and students</h2>
      <ul class="cards">
        {AUDIENCES.map((audience) => (
          <li>
            <a href={audiencePath(lang, audience)}>{audienceLabel(lang, audience)}</a>
            <p class="meta">
              {audience === "teachers"
                ? "Preparation, teaching and school planning: lesson plans, worksheets, curriculum coverage analysis and assessment tools."
                : audience === "parents"
                  ? "Guiding AI homework at home: activities to do together, a family homework agreement and a parent notice."
                  : "Projects and checking what an AI tells you: worksheets, steps and record sheets to use directly."}
            </p>
          </li>
        ))}
      </ul>

      <h2>Why we build it</h2>
      <p>
        Learning to use AI well should not depend on how much a school can budget for it, or on how
        much a parent knows about technology. The slow step in a classroom is turning official
        documents and guidance into material that can be used tomorrow — so we do that step, and
        teachers, parents and students can download the result directly. If the material you need is
        not here, <a href={feedbackPath(lang)}>tell us</a> and we will prioritise it.
      </p>

      <h2>About Beets Limited</h2>
      <p>
        Beets Limited is a Hong Kong creative-technology education company. We use AI, 3D design and
        3D printing to help schools, families, businesses and makers turn an idea into a finished
        thing: STEM programmes for schools, 3D and AI creative workshops, 3D design and printing
        services, and the equipment and materials that go with them.
      </p>
      <p>
        This library is the other side of that work. We take what we have learned in classrooms and
        workshops and turn it into material anyone can download and use. To see our courses,
        services and products, visit beets3d.com.
      </p>
      <p>
        <a class="btn" href={ORG_SITE} target="_blank" rel="noopener noreferrer">
          beets3d.com →
        </a>
      </p>

      <h2>Reuse and privacy</h2>
      <ul>
        <li>Download and adapt the resources freely for teaching; please keep the attribution.</li>
        <li>Where third-party material is used, we link the original source.</li>
        <li>We collect no student work and nothing that could identify a student.</li>
        <li>
          Downloads need no registration; an email address is only used, with consent, to tell you
          about new resources.
        </li>
        <li>
          We count page views and downloads in aggregate with Google Analytics: it shows us which
          resources are used, not who is reading.
        </li>
      </ul>
    </>
  )
}

<style>
  /* One block of prose, so the page reads as a statement rather than a form. */
  h2 {
    margin-top: 2.5rem;
  }
  .lead {
    font-size: 1.1rem;
  }
</style>
