{
  "name": "beets-ai-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beets AI — free Hong Kong AI teaching-resource library (beets-ai.com)",
  "scripts": {
    "predev": "node scripts/gen-revisions.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-revisions.mjs && node scripts/gen-llms-txt.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "node scripts/gen-revisions.mjs",
    "check": "astro check",
    "pretest": "node scripts/gen-revisions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-external-links.mjs",
    "check:lang": "node scripts/check-language.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:nav": "node scripts/check-nav-align.mjs",
    "check:public-copy": "node scripts/check-public-copy.mjs",
    "check:meta": "node scripts/check-meta.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
